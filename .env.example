# =====================================================================
# Quills and Ink Hub — Analytics & SEO Configuration
# =====================================================================

# 1. Google Analytics 4 (Measurement ID)
# Format: G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=

# 2. Plausible Analytics (Privacy-first, cookieless)
# Domain name as configured in your Plausible dashboard
PUBLIC_PLAUSIBLE_DOMAIN=

# 3. Cloudflare Web Analytics
# Beacon Token from Cloudflare Dashboard > Analytics & Logs > Web Analytics
PUBLIC_CF_BEACON_TOKEN=

# 4. PostHog Product Analytics (Optional)
PUBLIC_POSTHOG_KEY=

# 5. Site Base URL for SEO canonicals and sitemaps (Override if using custom domain)
PUBLIC_SITE_URL=https://quills-and-ink-hub.pages.dev
