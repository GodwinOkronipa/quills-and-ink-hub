---
const services = [
  {
    title: 'Coordination',
    href: '/packages',
    image:
      'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80',
    alt: 'Elegant event venue setup with warm lighting',
  },
  {
    title: 'Consultation',
    href: '/book',
    image:
      'https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1200&q=80',
    alt: 'Hands writing thoughtfully with a fountain pen',
  },
  {
    title: 'Portfolio',
    href: '/portfolio',
    image: '/images/portfolio/nicholas-nii-adamma/01-casket-kente-tribute.jpg',
    alt: 'Handwoven Kente drape on ceremonial casket with floral tribute',
  },
  {
    title: 'Literary Care',
    href: '/literary',
    image:
      'https://images.unsplash.com/photo-1457369804613-52c61a468e7d?auto=format&fit=crop&w=1200&q=80',
    alt: 'Open book and soft pages suggesting literary tribute',
  },
];
---

<section class="services" aria-labelledby="services-heading">
  <div class="services__wood">
    <h2 id="services-heading" class="sr-only">Our services</h2>
    <div class="services__track container-wide" data-services-track>
      {
        services.map((item) => (
          <a class="services__card" href={item.href}>
            <img src={item.image} alt={item.alt} width="800" height="520" loading="lazy" />
            <span class="services__label">{item.title}</span>
          </a>
        ))
      }
    </div>

    <button class="services__arrow services__arrow--prev" type="button" data-services-prev aria-label="Previous service">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" />
      </svg>
    </button>
    <button class="services__arrow services__arrow--next" type="button" data-services-next aria-label="Next service">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 18l6-6-6-6" />
      </svg>
    </button>
  </div>
</section>

<style>
  .services {
    margin-top: 0;
  }

  .services__wood {
    position: relative;
    background:
      linear-gradient(180deg, rgba(28, 22, 16, 0.92), rgba(28, 22, 16, 0.88)),
      url('https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1600&q=60')
        center / cover;
    padding: 6.5rem 0 4rem;
    color: var(--color-white);
    overflow: hidden;
  }

  .services__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 86vw);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-inline: 1rem;
  }

  .services__track::-webkit-scrollbar {
    display: none;
  }

  .services__card {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 16rem;
    overflow: hidden;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    border-radius: 3px;
    text-decoration: none;
  }

  .services__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .services__card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(20, 16, 12, 0.44);
    transition: background 0.3s var(--ease);
  }

  .services__card:hover img {
    transform: scale(1.05);
  }

  .services__card:hover::after {
    background: rgba(20, 16, 12, 0.32);
  }

  .services__label {
    position: relative;
    z-index: 1;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
    color: var(--color-white);
    letter-spacing: 0.02em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
    text-align: center;
    padding: 0 1rem;
  }

  /* Side navigation buttons - visible and styled on mobile & desktop */
  .services__arrow {
    display: grid;
    place-items: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    background: rgba(24, 18, 14, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-white);
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    transition:
      background 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .services__arrow:hover {
    background: rgba(24, 18, 14, 0.95);
    border-color: var(--color-peach);
    color: var(--color-peach-light, #ffd5b5);
    transform: translateY(-50%) scale(1.08);
  }

  .services__arrow:active {
    transform: translateY(-50%) scale(0.92);
  }

  .services__arrow--prev {
    left: 0.6rem;
  }

  .services__arrow--next {
    right: 0.6rem;
  }

  @media (min-width: 680px) {
    .services__track {
      grid-auto-columns: minmax(300px, calc((100% - 1rem) / 2));
      padding-inline: 0.5rem;
    }
  }

  @media (min-width: 960px) {
    .services__wood {
      padding: 8.5rem 0 5rem;
    }

    .services__track {
      grid-auto-columns: calc((100% - 2rem) / 3);
      gap: 1rem;
      padding-inline: 0;
    }

    .services__card {
      min-height: 18rem;
    }

    .services__arrow {
      width: 2.85rem;
      height: 2.85rem;
    }

    .services__arrow--prev {
      left: 1.25rem;
    }

    .services__arrow--next {
      right: 1.25rem;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-services-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-services-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-services-next]');

  if (track) {
    const getScrollStep = () => {
      const firstCard = track.querySelector<HTMLElement>('.services__card');
      if (!firstCard) return track.clientWidth * 0.85;
      const gap = parseFloat(window.getComputedStyle(track).gap) || 16;
      return firstCard.offsetWidth + gap;
    };

    const scrollByCard = (dir: number) => {
      const step = getScrollStep();
      const maxScroll = track.scrollWidth - track.clientWidth;
      
      // If at end and moving next -> smoothly loop back to start
      if (dir > 0 && track.scrollLeft >= maxScroll - 20) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else if (dir < 0 && track.scrollLeft <= 20) {
        // If at start and moving prev -> loop to end
        track.scrollTo({ left: maxScroll, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: step * dir, behavior: 'smooth' });
      }
    };

    let autoScrollInterval: number | undefined;
    let pauseTimeout: number | undefined;
    let isUserInteracting = false;

    const shouldAutoScroll = () => {
      return track.scrollWidth > track.clientWidth + 10 && !isUserInteracting;
    };

    const advanceSlide = () => {
      if (shouldAutoScroll()) {
        scrollByCard(1);
      }
    };

    const startAutoScroll = () => {
      stopAutoScroll();
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      autoScrollInterval = window.setInterval(advanceSlide, 3500);
    };

    const stopAutoScroll = () => {
      if (autoScrollInterval) {
        window.clearInterval(autoScrollInterval);
        autoScrollInterval = undefined;
      }
    };

    const pauseTemporarily = (duration = 5000) => {
      isUserInteracting = true;
      stopAutoScroll();
      if (pauseTimeout) window.clearTimeout(pauseTimeout);
      pauseTimeout = window.setTimeout(() => {
        isUserInteracting = false;
        startAutoScroll();
      }, duration);
    };

    prev?.addEventListener('click', () => {
      scrollByCard(-1);
      pauseTemporarily();
    });

    next?.addEventListener('click', () => {
      scrollByCard(1);
      pauseTemporarily();
    });

    // Pause on user touch or swipe on mobile
    track.addEventListener('touchstart', () => {
      isUserInteracting = true;
      stopAutoScroll();
    }, { passive: true });

    track.addEventListener('touchend', () => {
      pauseTemporarily(4000);
    }, { passive: true });

    // Pause on desktop mouse hover
    track.addEventListener('mouseenter', () => {
      isUserInteracting = true;
      stopAutoScroll();
    });

    track.addEventListener('mouseleave', () => {
      isUserInteracting = false;
      startAutoScroll();
    });

    // Start auto-scrolling
    startAutoScroll();
  }
</script>
