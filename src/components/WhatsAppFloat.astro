---
// Floating WhatsApp button for immediate consultation and diaspora support
// - Expands fully on first tap (or on initial load / return to top)
// - Opens WhatsApp when tapped while expanded
// - Shrinks into a single circle after 2.5 seconds
// - Disappears when scrolled down
---

<a
  href="https://wa.me/233539223757?text=Hello%20Quills%20and%20Ink%20Hub,%20I%20would%20like%20to%20inquire%20about%20your%20funeral%20and%20literary%20services."
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-float"
  data-whatsapp-float
  data-state="expanded"
  aria-label="Contact Us on WhatsApp"
  aria-expanded="true"
>
  <span class="whatsapp-float__icon" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
      <path
        d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.46 0 .09 5.37.09 11.97c0 2.11.55 4.16 1.6 5.97L0 24l6.23-1.63a11.94 11.94 0 0 0 5.83 1.51h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.21-3.52-8.43zM12.07 21.88h-.01c-1.79 0-3.55-.48-5.08-1.39l-.36-.22-3.77.99 1.01-3.68-.24-.38a9.92 9.92 0 0 1-1.52-5.23c0-5.48 4.47-9.95 9.97-9.95 2.66 0 5.16 1.04 7.04 2.92 1.88 1.88 2.92 4.38 2.92 7.04 0 5.49-4.47 9.9-9.95 9.9zm5.46-7.46c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.49-.9-.8-1.5-1.79-1.67-2.09-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.21 3.07c.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.72.23 1.37.2 1.89.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35z"
      />
    </svg>
  </span>
  <span class="whatsapp-float__label">Contact Us on WhatsApp</span>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 99;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #4a3828;
    color: #ffffff;
    border: 1px solid rgba(201, 168, 146, 0.45);
    box-shadow: 0 10px 30px rgba(61, 50, 38, 0.38), 0 4px 14px rgba(0, 0, 0, 0.18);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    white-space: nowrap;
    user-select: none;
    transition:
      width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease),
      visibility 0.4s,
      box-shadow 0.3s var(--ease),
      background 0.3s var(--ease),
      border-color 0.3s var(--ease);
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
  }

  .whatsapp-float:hover {
    background: #38291c;
    border-color: rgba(201, 168, 146, 0.85);
    box-shadow: 0 14px 38px rgba(61, 50, 38, 0.52), 0 6px 18px rgba(0, 0, 0, 0.25);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Expanded Pill State */
  .whatsapp-float[data-state="expanded"] {
    width: auto;
    height: 3.25rem;
    padding: 0 1.35rem 0 0.85rem;
    border-radius: 999px;
  }

  /* Shrunk Single Circle State */
  .whatsapp-float[data-state="circle"] {
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    border-radius: 50%;
  }

  .whatsapp-float__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .whatsapp-float__label {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    line-height: 1;
    transition:
      max-width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .whatsapp-float[data-state="expanded"] .whatsapp-float__label {
    max-width: 260px;
    opacity: 1;
    margin-left: 0.15rem;
  }

  .whatsapp-float[data-state="circle"] .whatsapp-float__label {
    max-width: 0;
    opacity: 0;
    margin-left: 0;
    padding: 0;
  }

  /* Disappears when scrolled down */
  .whatsapp-float.is-hidden {
    opacity: 0;
    transform: translateY(24px);
    visibility: hidden;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .whatsapp-float {
      bottom: 1.25rem;
      right: 1.25rem;
    }

    .whatsapp-float[data-state="expanded"] {
      height: 3rem;
      padding: 0 1.15rem 0 0.75rem;
      font-size: 0.7rem;
    }

    .whatsapp-float[data-state="circle"] {
      width: 3rem;
      height: 3rem;
    }

    .whatsapp-float__icon {
      width: 3rem;
      height: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float,
    .whatsapp-float__label {
      transition: opacity 0.25s linear, visibility 0.25s;
    }
    .whatsapp-float.is-hidden {
      transform: none;
    }
  }
</style>

<script>
  const waBtn = document.querySelector<HTMLAnchorElement>('[data-whatsapp-float]');

  if (waBtn) {
    let shrinkTimer: number | undefined;
    let isHidden = false;

    const shrinkToCircle = () => {
      waBtn.setAttribute('data-state', 'circle');
      waBtn.setAttribute('aria-expanded', 'false');
    };

    const expandFully = () => {
      waBtn.setAttribute('data-state', 'expanded');
      waBtn.setAttribute('aria-expanded', 'true');
      scheduleShrink();
    };

    const scheduleShrink = () => {
      window.clearTimeout(shrinkTimer);
      // After two and a half seconds (2.5s) of being visible, shrink into a single circle
      shrinkTimer = window.setTimeout(() => {
        shrinkToCircle();
      }, 2500);
    };

    // Initial load: starts expanded, then shrinks after 2.5 seconds
    scheduleShrink();

    // Click / Tap behavior:
    // 1. If currently in the shrunken circle state: expand fully when tapped, do NOT open link yet.
    // 2. If already expanded: open WhatsApp link with number on next tap!
    waBtn.addEventListener('click', (e) => {
      const currentState = waBtn.getAttribute('data-state');

      if (currentState === 'circle') {
        e.preventDefault();
        e.stopPropagation();
        expandFully();
      } else {
        // Already expanded -> allow navigation to WhatsApp
        scheduleShrink();
      }
    });

    // Disappearing behavior when scrolled down
    const onScroll = () => {
      const scrollY = window.scrollY;
      if (scrollY > 80) {
        if (!isHidden) {
          waBtn.classList.add('is-hidden');
          isHidden = true;
          window.clearTimeout(shrinkTimer);
        }
      } else {
        if (isHidden) {
          waBtn.classList.remove('is-hidden');
          isHidden = false;
          // Re-expand when returned to top, then shrink after 2.5s
          expandFully();
        }
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    // Check initial scroll state
    onScroll();
  }
</script>
