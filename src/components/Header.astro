---
interface Props {
  variant?: 'transparent' | 'solid';
}

const { variant = 'transparent' } = Astro.props;

const leftLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/packages', label: 'Packages' },
  { href: '/literary', label: 'Literary' },
];

const rightLinks = [
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/book', label: 'Book' },
  { href: '/contact', label: 'Contact' },
];
---

<header class:list={['site-header', variant === 'solid' && 'site-header--solid']} data-header>
  <div class="site-header__inner container-wide">
    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
      aria-label="Toggle navigation menu"
    >
      <span class="sr-only">Menu</span>
      <span class="site-header__bar"></span>
      <span class="site-header__bar"></span>
    </button>

    <nav class="site-header__nav site-header__nav--left" aria-label="Primary left">
      {
        leftLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>

    <a class="site-header__brand" href="/" aria-label="Quills and Ink Hub home">
      <span class="site-header__logo script">Quills &amp; Ink</span>
      <span class="site-header__tag">Funeral Planning &amp; Literary Services</span>
    </a>

    <nav class="site-header__nav site-header__nav--right" aria-label="Primary right">
      {
        rightLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>
  </div>

  <nav id="site-nav" class="site-header__mobile" data-mobile-nav hidden>
    <div class="site-header__mobile-top">
      <span class="eyebrow" style="color: var(--color-blush);">Menu</span>
      <button type="button" class="site-header__close" data-nav-close aria-label="Close navigation menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    {[...leftLinks, ...rightLinks].map((link) => (
      <a href={link.href} class="site-header__mobile-link">{link.label}</a>
    ))}
    <a class="btn btn--peach" href="/book">Book a Consultation</a>
  </nav>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 40;
    color: var(--color-white);
    padding-top: 1.25rem;
  }

  .site-header--solid {
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--color-ivory) 92%, transparent);
    backdrop-filter: blur(12px);
    color: var(--color-charcoal);
    border-bottom: 1px solid var(--color-line);
    padding-block: 0.85rem;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: var(--nav-h);
  }

  .site-header__brand {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.15rem;
  }

  .site-header__logo {
    font-size: clamp(2rem, 3vw, 2.75rem);
    line-height: 1;
    color: inherit;
  }

  .site-header__tag {
    font-size: 0.55rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.8;
    font-weight: 400;
  }

  .site-header__nav {
    display: none;
    gap: 1.35rem;
    align-items: center;
  }

  .site-header__nav a {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 400;
    opacity: 0.92;
    transition: opacity 0.25s var(--ease);
  }

  .site-header__nav a:hover {
    opacity: 0.6;
  }

  .site-header__nav--left {
    justify-content: flex-start;
  }

  .site-header__nav--right {
    justify-content: flex-end;
  }

  .site-header__toggle {
    display: grid;
    gap: 0.45rem;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.25rem;
    border: 0;
    background: transparent;
    cursor: pointer;
    justify-self: start;
    align-content: center;
    color: currentColor;
  }

  .site-header__toggle .site-header__bar {
    display: block;
    width: 1.5rem;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
  }

  .site-header__toggle.is-open .site-header__bar:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .site-header__toggle.is-open .site-header__bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .site-header__mobile {
    display: grid;
    gap: 1.15rem;
    padding: 1.5rem 1.5rem 2.25rem;
    background: var(--color-charcoal);
    color: var(--color-white);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
    animation: fade-down 0.25s var(--ease);
  }

  @keyframes fade-down {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .site-header__mobile-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .site-header__close {
    background: transparent;
    border: none;
    color: var(--color-white);
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0.25rem;
    opacity: 0.8;
    transition: opacity 0.2s var(--ease);
  }

  .site-header__close:hover {
    opacity: 1;
  }

  .site-header__mobile a:not(.btn) {
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 0.25rem 0;
    transition: color 0.2s var(--ease);
  }

  .site-header__mobile a:not(.btn):hover {
    color: var(--color-blush);
  }

  .site-header__mobile .btn {
    justify-self: start;
    margin-top: 0.5rem;
  }

  @media (min-width: 980px) {
    .site-header__toggle,
    .site-header__mobile {
      display: none !important;
    }

    .site-header__nav {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-nav-close]');

  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.classList.remove('is-open');
    if (mobileNav) {
      mobileNav.hidden = true;
    }
  };

  const openMenu = () => {
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.classList.add('is-open');
    if (mobileNav) {
      mobileNav.hidden = false;
    }
  };

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  closeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeMenu();
  });

  // When any link inside the mobile menu is pressed, disappear the nav menu
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  // Also close when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (mobileNav && !mobileNav.hidden && !toggle?.contains(target) && !mobileNav.contains(target)) {
      closeMenu();
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMenu();
    }
  });
</script>

