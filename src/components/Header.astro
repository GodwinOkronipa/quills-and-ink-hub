---
interface Props {
  variant?: 'transparent' | 'solid';
}

const { variant = 'transparent' } = Astro.props;

const leftLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/packages', label: 'Packages' },
  { href: '/literary', label: 'Literary' },
];

const rightLinks = [
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/book', label: 'Book' },
  { href: '/contact', label: 'Contact' },
];
---

<header
  class:list={['site-header', variant === 'solid' && 'site-header--solid']}
  data-header
>
  <div class="site-header__inner container-wide">
    <!-- Hamburger button (Mobile) -->
    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-drawer"
      data-nav-toggle
      aria-label="Open navigation menu"
    >
      <span class="sr-only">Menu</span>
      <span class="site-header__bar"></span>
      <span class="site-header__bar"></span>
      <span class="site-header__bar"></span>
    </button>

    <!-- Desktop Navigation Left -->
    <nav class="site-header__nav site-header__nav--left" aria-label="Primary left">
      {
        leftLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>

    <!-- Brand Logo (Centered) -->
    <a class="site-header__brand" href="/" aria-label="Quills and Ink Hub home">
      <span class="site-header__logo script">Quills &amp; Ink</span>
      <span class="site-header__tag">Funeral Planning &amp; Literary Services</span>
    </a>

    <!-- Desktop Navigation Right -->
    <nav class="site-header__nav site-header__nav--right" aria-label="Primary right">
      {
        rightLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>

    <!-- Mobile Quick CTA -->
    <a class="site-header__mobile-cta btn btn--peach" href="/book">
      Book
    </a>
  </div>
</header>

<!-- Mobile Drawer Backdrop (Rendered outside header to prevent backdrop-filter containment clipping) -->
<div class="site-drawer__backdrop" data-drawer-backdrop aria-hidden="true"></div>

<!-- Mobile Off-Canvas Drawer (Rendered outside header to cover the full viewport without cutoff) -->
<aside
  id="site-drawer"
  class="site-drawer"
  data-drawer
  aria-label="Mobile Navigation"
  aria-hidden="true"
>
  <div class="site-drawer__header">
    <div class="site-drawer__brand">
      <span class="script site-drawer__logo">Quills &amp; Ink</span>
      <span class="site-drawer__tag">Ghana &amp; Diaspora Care</span>
    </div>
    <button
      type="button"
      class="site-drawer__close"
      data-drawer-close
      aria-label="Close navigation menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="site-drawer__nav">
    {[...leftLinks, ...rightLinks].map((link) => (
      <a href={link.href} class="site-drawer__link" data-nav-link>
        <span>{link.label}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    ))}
  </nav>

  <div class="site-drawer__footer">
    <a class="btn btn--peach site-drawer__btn" href="/book" data-nav-link>
      Book a Consultation
    </a>
    <a
      class="btn btn--ghost site-drawer__btn"
      href="https://wa.me/233240000000?text=Hello%20Quills%20and%20Ink%20Hub,%20I%20would%20like%20to%20inquire%20about%20your%20services."
      target="_blank"
      rel="noopener noreferrer"
      data-nav-link
    >
      Chat on WhatsApp
    </a>
  </div>
</aside>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 40;
    color: var(--color-white);
    padding-top: 0.75rem;
    transition: background 0.3s var(--ease), padding 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .site-header--solid {
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--color-ivory) 94%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-charcoal);
    border-bottom: 1px solid var(--color-line);
    padding-block: 0.75rem;
  }

  /* Scrolled sticky state for all variants */
  .site-header.is-scrolled {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    background: rgba(26, 22, 18, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    color: var(--color-white);
  }

  .site-header--solid.is-scrolled {
    background: color-mix(in srgb, var(--color-ivory) 96%, transparent);
    color: var(--color-charcoal);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  /* Header inner container: Mobile First */
  .site-header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    min-height: 4rem;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 1rem;
    box-sizing: border-box;
  }

  .site-header__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }

  .site-header__logo {
    font-size: clamp(1.6rem, 5.5vw, 2.75rem);
    line-height: 1;
    color: inherit;
    white-space: nowrap;
  }

  .site-header__tag {
    font-size: clamp(0.42rem, 1.8vw, 0.55rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  /* Hamburger Toggle Button */
  .site-header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.32rem;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.25rem;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: currentColor;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .site-header__toggle:focus-visible {
    outline: 2px solid var(--color-peach);
  }

  .site-header__bar {
    display: block;
    width: 1.35rem;
    height: 1.75px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
  }

  /* Mobile Quick CTA */
  .site-header__mobile-cta {
    padding: 0.4rem 0.85rem;
    min-height: 2rem;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    flex-shrink: 0;
  }

  /* Desktop Nav Links (Hidden on Mobile) */
  .site-header__nav {
    display: none;
    gap: 1.35rem;
    align-items: center;
    flex: 1;
  }

  .site-header__nav a {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 400;
    opacity: 0.92;
    transition: opacity 0.25s var(--ease);
    white-space: nowrap;
  }

  .site-header__nav a:hover {
    opacity: 0.6;
  }

  .site-header__nav--left {
    justify-content: flex-start;
  }

  .site-header__nav--right {
    justify-content: flex-end;
  }

  /* Desktop Breakpoint */
  @media (min-width: 980px) {
    .site-header {
      padding-top: 1.25rem;
    }

    .site-header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      min-height: var(--nav-h);
      gap: 1rem;
      padding-inline: 1.5rem;
    }

    .site-header__toggle,
    .site-header__mobile-cta {
      display: none !important;
    }

    .site-header__nav {
      display: flex;
    }

    .site-header__tag {
      letter-spacing: 0.22em;
      font-size: 0.52rem;
    }
  }

  /* Mobile Drawer Backdrop */
  .site-drawer__backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background: rgba(18, 14, 11, 0.78);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s var(--ease), visibility 0.35s;
  }

  .site-drawer__backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Mobile Off-Canvas Drawer Container */
  .site-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    height: 100vh;
    height: 100dvh;
    width: 100%;
    background: var(--color-charcoal);
    color: var(--color-white);
    z-index: 9999;
    transform: translateX(-100%);
    box-shadow: 10px 0 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    box-sizing: border-box;
  }

  @media (min-width: 540px) {
    .site-drawer {
      width: 380px;
      max-width: 85vw;
    }
  }

  .site-drawer.is-open {
    transform: translateX(0);
  }

  .site-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }

  .site-drawer__brand {
    display: grid;
    gap: 0.1rem;
  }

  .site-drawer__logo {
    font-size: 2rem;
    color: var(--color-white);
    line-height: 1;
  }

  .site-drawer__tag {
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-peach);
  }

  .site-drawer__close {
    background: transparent;
    border: none;
    color: var(--color-white);
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.25rem;
    border-radius: 8px;
    opacity: 0.9;
    transition: opacity 0.2s var(--ease), background 0.2s;
  }

  .site-drawer__close:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.1);
  }

  .site-drawer__nav {
    display: grid;
    gap: 0.25rem;
    flex: 1;
  }

  .site-drawer__link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-white);
    border-radius: 6px;
    transition: background 0.2s var(--ease), color 0.2s;
  }

  .site-drawer__link:hover,
  .site-drawer__link:active {
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-blush);
  }

  .site-drawer__link svg {
    opacity: 0.5;
    transition: transform 0.2s var(--ease), opacity 0.2s;
  }

  .site-drawer__link:hover svg {
    opacity: 1;
    transform: translateX(3px);
  }

  .site-drawer__footer {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.5rem;
    margin-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    flex-shrink: 0;
  }

  .site-drawer__btn {
    width: 100%;
    justify-content: center;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-drawer-close]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const backdrop = document.querySelector<HTMLElement>('[data-drawer-backdrop]');
  const drawerLinks = document.querySelectorAll<HTMLElement>('[data-nav-link]');

  const openDrawer = () => {
    toggleBtn?.setAttribute('aria-expanded', 'true');
    drawer?.setAttribute('aria-hidden', 'false');
    drawer?.classList.add('is-open');
    backdrop?.classList.add('is-open');
    document.body.classList.add('drawer-open');
  };

  const closeDrawer = () => {
    toggleBtn?.setAttribute('aria-expanded', 'false');
    drawer?.setAttribute('aria-hidden', 'true');
    drawer?.classList.remove('is-open');
    backdrop?.classList.remove('is-open');
    document.body.classList.remove('drawer-open');
  };

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = drawer?.classList.contains('is-open');
    if (isOpen) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  closeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeDrawer();
  });

  backdrop?.addEventListener('click', () => {
    closeDrawer();
  });

  // Automatically dismiss the nav menu when ANY link or button is pressed
  drawerLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeDrawer();
    });
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
      closeDrawer();
    }
  });

  // Sticky header behavior on scroll
  const handleScroll = () => {
    if (!header) return;
    if (window.scrollY > 40) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>
