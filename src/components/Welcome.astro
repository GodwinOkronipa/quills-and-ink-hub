---
---

<section class="welcome" id="about-preview">
  <div class="welcome__card container" data-reveal="fade-up">
    <figure class="welcome__figure">
      <img
        src="https://images.unsplash.com/photo-1616504132231-c167f6f33ea5?auto=format&fit=crop&w=1000&q=80"
        alt="Solemn white roses in a clear glass vase"
        width="1000"
        height="1250"
        loading="lazy"
      />
      <div class="welcome__figure-overlay" aria-hidden="true"></div>
    </figure>

    <div class="welcome__copy">
      <span class="eyebrow" data-reveal="fade-up" data-delay="100">Care That Listens First</span>
      <h2 data-reveal="fade-up" data-delay="200">
        Welcome to Quills and Ink Hub — thoughtful funeral planning and literary
        care for Ghanaian families at home and abroad.
      </h2>
      <p data-reveal="fade-up" data-delay="300">
        In moments of loss, clarity and dignity matter. We coordinate memorial
        gatherings with cultural sensitivity, and craft eulogies, tributes, and
        programmes that honour a life with grace.
      </p>
      <p data-reveal="fade-up" data-delay="400">
        Whether you are arranging from Accra or supporting loved ones from the
        diaspora, we walk beside you — calmly, carefully, and with respect.
      </p>
      <a class="text-link welcome__link" href="/about" data-reveal="fade-up" data-delay="500">
        <span>Read our story</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .welcome {
    position: relative;
    z-index: 2;
    margin-top: -5.5rem;
    padding-bottom: 2rem;
  }

  .welcome__card {
    display: grid;
    background: var(--color-white);
    box-shadow: 0 20px 50px rgba(26, 22, 18, 0.12), 0 4px 16px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(230, 224, 216, 0.7);
    overflow: hidden;
    border-radius: 4px;
    transition: box-shadow 0.4s var(--ease), transform 0.4s var(--ease);
  }

  .welcome__card:hover {
    box-shadow: 0 28px 70px rgba(26, 22, 18, 0.16), 0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .welcome__figure {
    position: relative;
    margin: 0;
    min-height: 22rem;
    overflow: hidden;
  }

  .welcome__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease), filter 1s var(--ease);
  }

  .welcome__figure-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(26, 22, 18, 0.3) 100%);
    pointer-events: none;
  }

  .welcome__card:hover .welcome__figure img {
    transform: scale(1.04);
    filter: brightness(1.02);
  }

  .welcome__copy {
    padding: 2.75rem 2rem 3.25rem;
    display: grid;
    gap: 1.15rem;
    align-content: center;
  }

  .welcome__copy .eyebrow {
    color: var(--color-peach-deep);
    font-weight: 600;
  }

  .welcome__copy h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.35rem);
    color: var(--color-charcoal);
    line-height: 1.25;
  }

  .welcome__copy p {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .welcome__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    margin-top: 0.5rem;
    color: var(--color-charcoal);
    font-weight: 500;
    transition: color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .welcome__link svg {
    transition: transform 0.25s var(--ease);
  }

  .welcome__link:hover {
    color: var(--color-peach-deep);
  }

  .welcome__link:hover svg {
    transform: translateX(4px);
  }

  @media (min-width: 880px) {
    .welcome {
      margin-top: -7.5rem;
      padding-bottom: 0;
    }

    .welcome__card {
      grid-template-columns: 0.9fr 1.1fr;
      min-height: 29rem;
    }

    .welcome__copy {
      padding: 3.75rem 3.5rem;
    }

    .welcome__figure {
      transform: translateY(-1.5rem);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
    }
  }
</style>
