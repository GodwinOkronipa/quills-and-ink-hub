---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__top container">
    <div class="site-footer__brand">
      <p class="script site-footer__logo">Quills &amp; Ink</p>
      <p>
        Honouring lives with careful coordination and words that carry love —
        for families in Ghana and across the diaspora.
      </p>
    </div>

    <div>
      <p class="eyebrow">Explore</p>
      <ul>
        <li><a href="/packages">Funeral Packages</a></li>
        <li><a href="/literary">Literary Services</a></li>
        <li><a href="/downloads/eulogy-writing-guide.pdf" download data-track-download="true" data-download-name="Eulogy Writing Guide (PDF)" data-attribution="Quills &amp; Ink Hub">Eulogy Guide (PDF)</a></li>
        <li><a href="/downloads/memorial-brochure-checklist.pdf" download data-track-download="true" data-download-name="Memorial Brochure Checklist (PDF)" data-attribution="Quills &amp; Ink Hub">Brochure Checklist (PDF)</a></li>
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a href="/book">Book Consultation</a></li>
        <li><button type="button" class="footer-search-btn" data-open-search>Search Site (⌘K)</button></li>
      </ul>
    </div>

    <div>
      <p class="eyebrow">Reach Us</p>
      <ul>
        <li>
          <a href="tel:+233539223757">+233 53 922 3757</a>
        </li>
        <li>
          <a href="mailto:hello@quillsandinkhub.com">hello@quillsandinkhub.com</a>
        </li>
        <li>
          <a
            href="https://wa.me/233539223757?text=Hello%20Quills%20and%20Ink%20Hub,%20I%20would%20like%20to%20inquire%20about%20your%20services."
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp Support Desk
          </a>
        </li>
        <li>Accra, Ghana · Serving diaspora families worldwide</li>
      </ul>
    </div>
  </div>

  <div class="site-footer__bottom container">
    <p>© {year} Quills and Ink Hub. All rights reserved.</p>
    <div class="site-footer__bottom-links">
      <a href="/contact">Send an inquiry</a>
      <span aria-hidden="true" class="footer-separator">·</span>
      <div class="footer-socials" aria-label="Social media links">
        <a
          href="https://www.tiktok.com/@quillsandinkhub"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-social-link"
          aria-label="Quills and Ink on TikTok"
          title="TikTok"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.48 6.27 6.27 0 0 0 1.86-4.47V8.71a8.19 8.19 0 0 0 4.91 1.63V6.89a4.85 4.85 0 0 1-1-.2z"></path>
          </svg>
          <span>TikTok</span>
        </a>
        <a
          href="https://www.instagram.com/quillsandinkhub"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-social-link"
          aria-label="Quills and Ink on Instagram"
          title="Instagram"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span>Instagram</span>
        </a>
      </div>
      <span aria-hidden="true" class="footer-separator">·</span>
      <a
        href="https://bookflywheel.com"
        target="_blank"
        rel="noopener noreferrer"
        class="flywheel-link"
        title="Powered by Flywheel"
      >
        Powered by Flywheel
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal);
    color: color-mix(in srgb, white 78%, transparent);
    padding: 4.5rem 0 1.75rem;
  }

  .site-footer__top {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid color-mix(in srgb, white 12%, transparent);
  }

  .site-footer__logo {
    font-size: 2.5rem;
    color: var(--color-white);
    margin-bottom: 0.75rem;
  }

  .site-footer__brand p:last-child {
    max-width: 28rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }

  .eyebrow {
    color: var(--color-blush);
    margin-bottom: 1rem;
  }

  ul {
    display: grid;
    gap: 0.75rem;
  }

  a,
  .footer-search-btn {
    transition: color 0.25s var(--ease);
  }

  .footer-search-btn {
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    text-align: left;
    padding: 0;
    cursor: pointer;
  }

  a:hover,
  .footer-search-btn:hover {
    color: var(--color-white);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    font-size: 0.8rem;
  }

  .site-footer__bottom-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.85rem;
  }

  .footer-separator {
    opacity: 0.35;
  }

  .footer-socials {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: color-mix(in srgb, white 78%, transparent);
    font-size: 0.78rem;
    text-decoration: none;
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .footer-social-link:hover {
    color: var(--color-peach);
    transform: translateY(-1px);
  }

  .footer-social-link svg {
    display: inline-block;
    flex-shrink: 0;
  }

  .flywheel-link {
    color: var(--color-peach-light, #ffd5b5);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    opacity: 0.85;
    transition: opacity 0.2s var(--ease), color 0.2s var(--ease);
    text-decoration: none;
  }
  .flywheel-link:hover {
    opacity: 1;
    color: var(--color-white);
    text-decoration: underline;
  }

  @media (min-width: 800px) {
    .site-footer__top {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
</style>
