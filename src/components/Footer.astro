---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__top container">
    <div class="site-footer__brand">
      <p class="script site-footer__logo">Quills &amp; Ink</p>
      <p>
        Honouring lives with careful coordination and words that carry love —
        for families in Ghana and across the diaspora.
      </p>
    </div>

    <div>
      <p class="eyebrow">Explore</p>
      <ul>
        <li><a href="/packages">Funeral Packages</a></li>
        <li><a href="/literary">Literary Services</a></li>
        <li><a href="/downloads/eulogy-writing-guide.pdf" download data-track-download="true" data-download-name="Eulogy Writing Guide (PDF)" data-attribution="Quills &amp; Ink Hub">Eulogy Guide (PDF)</a></li>
        <li><a href="/downloads/memorial-brochure-checklist.pdf" download data-track-download="true" data-download-name="Memorial Brochure Checklist (PDF)" data-attribution="Quills &amp; Ink Hub">Brochure Checklist (PDF)</a></li>
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a href="/book">Book Consultation</a></li>
        <li><button type="button" class="footer-search-btn" data-open-search>Search Site (⌘K)</button></li>
      </ul>
    </div>

    <div>
      <p class="eyebrow">Reach Us</p>
      <ul>
        <li>
          <a href="tel:+233240000000">+233 24 000 0000</a>
          <span class="footer-note-tag">(Updating soon)</span>
        </li>
        <li>
          <a href="mailto:hello@quillsandinkhub.com">hello@quillsandinkhub.com</a>
          <span class="footer-note-tag">(Updating soon)</span>
        </li>
        <li>
          <a
            href="https://wa.me/233240000000?text=Hello%20Quills%20and%20Ink%20Hub,%20I%20would%20like%20to%20inquire%20about%20your%20services."
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp Inquiry (Active Desk)
          </a>
        </li>
        <li>Accra, Ghana · Serving diaspora families worldwide</li>
      </ul>
      <p class="footer-update-disclaimer">
        Note: Official direct phone lines and primary email routing are actively being upgraded. WhatsApp messaging remains live daily.
      </p>
    </div>
  </div>

  <div class="site-footer__bottom container">
    <p>© {year} Quills and Ink Hub. All rights reserved.</p>
    <div class="site-footer__bottom-links">
      <a href="/contact">Send an inquiry</a>
      <span aria-hidden="true" style="opacity: 0.4;">·</span>
      <a href="/admin" class="footer-admin-link">Editorial Desk (Admin)</a>
      <span aria-hidden="true" style="opacity: 0.4;">·</span>
      <a
        href="https://bookflywheel.com"
        target="_blank"
        rel="noopener noreferrer"
        class="flywheel-link"
        title="Powered by Flywheel"
      >
        Powered by Flywheel
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal);
    color: color-mix(in srgb, white 78%, transparent);
    padding: 4.5rem 0 1.75rem;
  }

  .site-footer__top {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid color-mix(in srgb, white 12%, transparent);
  }

  .site-footer__logo {
    font-size: 2.5rem;
    color: var(--color-white);
    margin-bottom: 0.75rem;
  }

  .site-footer__brand p:last-child {
    max-width: 28rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }

  .eyebrow {
    color: var(--color-blush);
    margin-bottom: 1rem;
  }

  ul {
    display: grid;
    gap: 0.75rem;
  }

  a,
  .footer-search-btn {
    transition: color 0.25s var(--ease);
  }

  .footer-search-btn {
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    text-align: left;
    padding: 0;
    cursor: pointer;
  }

  a:hover,
  .footer-search-btn:hover {
    color: var(--color-white);
  }

  .footer-note-tag {
    font-size: 0.72rem;
    color: var(--color-peach);
    margin-left: 0.35rem;
    font-style: italic;
    opacity: 0.85;
  }

  .footer-update-disclaimer {
    font-size: 0.75rem;
    color: var(--color-peach);
    line-height: 1.45;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-style: italic;
    opacity: 0.85;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    font-size: 0.8rem;
  }

  .site-footer__bottom-links {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .footer-admin-link {
    opacity: 0.75;
    font-size: 0.75rem;
  }
  .footer-admin-link:hover {
    opacity: 1;
  }

  .flywheel-link {
    color: var(--color-peach-light, #ffd5b5);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    opacity: 0.85;
    transition: opacity 0.2s var(--ease), color 0.2s var(--ease);
    text-decoration: none;
  }
  .flywheel-link:hover {
    opacity: 1;
    color: var(--color-white);
    text-decoration: underline;
  }

  @media (min-width: 800px) {
    .site-footer__top {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
</style>
