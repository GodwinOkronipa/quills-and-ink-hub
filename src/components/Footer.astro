<style>
  .site-footer {
    background: var(--color-charcoal);
    color: color-mix(in srgb, white 78%, transparent);
    padding: 4.5rem 0 1.75rem;
  }

  .site-footer__top {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid color-mix(in srgb, white 12%, transparent);
  }

  .site-footer__logo {
    font-size: 2.5rem;
    color: var(--color-white);
    margin-bottom: 0.75rem;
  }

  .site-footer__brand p:last-child {
    max-width: 28rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }

  .eyebrow {
    color: var(--color-blush);
    margin-bottom: 1rem;
  }

  ul {
    display: grid;
    gap: 0.75rem;
  }

  a,
  .footer-search-btn {
    transition: color 0.25s var(--ease);
  }

  .footer-search-btn {
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    text-align: left;
    padding: 0;
    cursor: pointer;
  }

  a:hover,
  .footer-search-btn:hover {
    color: var(--color-white);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    font-size: 0.88rem;
  }

  .site-footer__bottom-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.85rem;
  }

  .footer-separator {
    opacity: 0.35;
  }

  .footer-socials {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: color-mix(in srgb, white 78%, transparent);
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .footer-social-link:hover {
    color: var(--color-peach);
    transform: translateY(-1px);
  }

  .footer-social-link svg {
    display: inline-block;
    flex-shrink: 0;
  }

  .flywheel-link {
    color: var(--color-peach-light, #ffd5b5);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    opacity: 0.85;
    transition: opacity 0.2s var(--ease), color 0.2s var(--ease);
    text-decoration: none;
  }
  .flywheel-link:hover {
    opacity: 1;
    color: var(--color-white);
    text-decoration: underline;
  }

  @media (min-width: 800px) {
    .site-footer__top {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
</style>
