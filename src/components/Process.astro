---
const steps = [
  {
    n: '01',
    title: 'Request a Consultation',
    text: 'Share your needs, location, and preferred time — including diaspora time zones.',
  },
  {
    n: '02',
    title: 'Gentle Confirmation',
    text: 'We confirm availability and outline what support will feel most helpful.',
  },
  {
    n: '03',
    title: 'We Plan With Care',
    text: 'Coordination, programmes, and literary pieces come together with your guidance.',
  },
  {
    n: '04',
    title: 'Honour the Day',
    text: 'You focus on family; we tend the details so the farewell feels dignified.',
  },
];
---

<section class="process" aria-labelledby="process-heading">
  <div class="container">
    <div class="process__intro" data-reveal="fade-up">
      <h2 id="process-heading" class="section-title section-title--accent">How We Walk With You</h2>
      <p class="eyebrow">A calm path from first call to farewell</p>
    </div>

    <ol class="process__steps">
      {
        steps.map((step, index) => (
          <li class="process__step" data-reveal="fade-up" data-delay={index * 120}>
            <span class="process__num" aria-hidden="true">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="process__path" aria-hidden="true" data-reveal="fade-in" data-delay="300">
      <svg viewBox="0 0 1100 80" fill="none" preserveAspectRatio="none">
        <path
          class="process__dash-line"
          d="M20 50 C 180 10, 280 70, 420 40 S 680 10, 820 45 S 980 70, 1060 30"
          stroke="#d9d0c6"
          stroke-width="1.8"
          stroke-dasharray="6 8"
        />
        <path d="M1050 22l18 8-18 8 4-8-4-8z" fill="#c9a892" />
      </svg>
    </div>

    <div class="process__cta" data-reveal="fade-up" data-delay="400">
      <a class="btn btn--ink process__btn" href="/book">
        <span>Begin with a consultation</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--color-white);
    padding: 5.5rem 0 5rem;
  }

  .process__intro {
    margin-bottom: 3rem;
  }

  .process__intro .eyebrow {
    margin-top: 0.85rem;
  }

  .process__steps {
    display: grid;
    gap: 2.25rem;
    counter-reset: none;
  }

  .process__step {
    padding: 1.25rem 1rem 1.25rem 0;
    transition: transform 0.3s var(--ease);
  }

  .process__step:hover {
    transform: translateY(-4px);
  }

  .process__num {
    display: block;
    font-family: var(--font-serif);
    font-size: 3.25rem;
    line-height: 1;
    color: #dfd8cf;
    margin-bottom: 0.75rem;
    transition: color 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .process__step:hover .process__num {
    color: var(--color-peach);
    transform: scale(1.05);
  }

  h3 {
    font-size: 1.35rem;
    margin-bottom: 0.55rem;
    color: var(--color-charcoal);
  }

  p {
    font-family: var(--font-serif);
    color: var(--color-muted);
    font-size: 1.02rem;
  }

  .process__path {
    display: none;
    margin: 2rem 0 2.5rem;
  }

  .process__path svg {
    width: 100%;
    height: 4.5rem;
  }

  .process__dash-line {
    animation: flow-dash 25s linear infinite;
  }

  @keyframes flow-dash {
    to {
      stroke-dashoffset: -400;
    }
  }

  .process__cta {
    margin-top: 2.5rem;
  }

  .process__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .process__btn svg {
    transition: transform 0.25s var(--ease);
  }

  .process__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(26, 22, 18, 0.18);
  }

  .process__btn:hover svg {
    transform: translateX(4px);
  }

  @media (min-width: 900px) {
    .process__steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
    }

    .process__path {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process__dash-line {
      animation: none;
    }
    .process__step:hover,
    .process__btn:hover {
      transform: none;
    }
  }
</style>
