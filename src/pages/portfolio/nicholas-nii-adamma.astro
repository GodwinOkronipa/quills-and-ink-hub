    border-left: 3px solid var(--color-peach);
    padding: 1rem 1.15rem;
  }

  .lightbox__notes {
    font-size: 0.88rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Footer Navigation */
  .case-footer {
    padding: 4.5rem 0 6rem;
  }

  .case-footer__box {
    background: var(--color-soft);
    border: 1px solid var(--color-line);
    padding: 3rem 2.5rem;
    display: flex;
    flex-wrap: wrap;
