---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const galleryImages = [
  {
    id: 'kente-casket',
    title: 'Casket Drapery & Floral Artistry',
    tag: 'Floral Artistry & Drapery',
    src: '/images/portfolio/nicholas-nii-adamma/01-casket-kente-tribute.jpg',
    aspect: 'wide',
    description:
      'The casket of the late Nicholas Nii Adamma draped in authentic woven Ghanaian Kente cloth, adorned with lush monstera foliage and pristine white floral wreath arrangements at the altar.',
    placeholderNotes:
      'Placeholder description: Detailed floral arrangement breakdown, choice of kente pattern, and altar positioning prepared for the thanksgiving service.',
  },
  {
    id: 'chapel-exterior',
    title: "All Souls' Chapel Grounds",
    tag: 'Venue & Grounds',
    src: '/images/portfolio/nicholas-nii-adamma/02-all-souls-chapel-exterior.jpg',
    aspect: 'wide',
    description:
      "Exterior perspective of All Souls' Chapel Interdenominational at Lashibi Funeral Home under clear skies, welcoming morning guests and family members to the solemn service.",
    placeholderNotes:
      'Placeholder description: Lashibi Funeral Home All Souls\' Chapel architecture, guest arrival staging, and serene surrounding landscape.',
  },
  {
    id: 'chapel-congregation',
    title: 'Sanctuary Gathering & Congregation',
    tag: 'Sanctuary Service',
    src: '/images/portfolio/nicholas-nii-adamma/03-chapel-sanctuary-congregation.jpg',
    aspect: 'wide',
    description:
      'An expansive view from the sanctuary platform capturing the congregation seated in traditional white funeral attire along the central red aisle runner.',
    placeholderNotes:
      'Placeholder description: Chapel capacity management, seating arrangement for family and sympathizers, and sanctuary atmosphere.',
  },
  {
    id: 'officiating-clergy',
    title: 'Scripture Exhortation & Clergy Officiation',
    tag: 'Liturgical Officiation',
    src: '/images/portfolio/nicholas-nii-adamma/04-officiating-clergy-sermon.jpg',
    aspect: 'portrait',
    description:
      'The officiating clergy delivering the sermon, prayer of thanksgiving, and scripture readings from the timber sanctuary lectern.',
    placeholderNotes:
      'Placeholder description: Order of worship, clergy coordination, sermon excerpt, and pastoral prayers.',
  },
  {
    id: 'family-elders',
    title: 'Family Elders & Dignitaries in Reflection',
    tag: 'Family Protocol',
    src: '/images/portfolio/nicholas-nii-adamma/05-family-elders-procession.jpg',
    aspect: 'portrait',
    description:
      'Family heads and elders of the widow seated in the front rows, dressed in ceremonial white woven cloths in solemn remembrance.',
    placeholderNotes:
      'Placeholder description: Seating order for chief mourners, family heads, and visiting community elders.',
  },
  {
    id: 'memorial-brochure',
    title: 'Memorial Keepsake Brochure in Hand',
    tag: 'Literature & Print',
    src: '/images/portfolio/nicholas-nii-adamma/06-congregation-memorial-brochure.jpg',
    aspect: 'portrait',
    description:
      'Mourners holding the official memorial service booklet, featuring the patriarch’s life story, tribute compilation, and order of service hymns.',
    placeholderNotes:
      'Placeholder description: Print design specifications, commemorative booklet layout, and tribute reading facilitation.',
  },
  {
    id: 'chief-mourners',
    title: 'Family Matriarchs & Chief Mourners',
    tag: 'Family Protocol',
    src: '/images/portfolio/nicholas-nii-adamma/07-chief-mourners-family.jpg',
    aspect: 'portrait',
    description:
      'Family matriarchs and chief mourners dressed in white lace attire and headwraps, holding solemn vigil during the farewell tributes.',
    placeholderNotes:
      'Placeholder description: Close family portrait, ceremonial headwraps and white memorial attire symbolism.',
  },
  {
    id: 'chapel-verandah',
    title: 'Chapel Verandah & Shaded Walkways',
    tag: 'Venue Coordination',
    src: '/images/portfolio/nicholas-nii-adamma/08-chapel-verandah-walkway.jpg',
    aspect: 'wide',
    description:
      "Covered walkways and shaded outdoor verandah at All Souls' Chapel accommodating mourners in a tranquil outdoor setting.",
    placeholderNotes:
      'Placeholder description: Overflow seating protocol, audio relay across the verandah, and guest comfort measures.',
  },
  {
    id: 'cortege-grounds',
    title: 'Cortege Assembly & Grounds Escort',
    tag: 'Cortege & Logistics',
    src: '/images/portfolio/nicholas-nii-adamma/09-cortege-grounds-escort.jpg',
    aspect: 'wide',
    description:
      'Vehicle cortege parking and security protocol escort stationed on the funeral home driveway before the committal journey.',
    placeholderNotes:
      'Placeholder description: Procession vehicle staging, traffic coordination, and escort protocols to the cemetery.',
  },
];
---

<BaseLayout
  title="Memorial Service of the Late Nicholas Nii Adamma Ammah (Opanin Kwame Darko) | Portfolio | Quills and Ink Hub"
  description="A photographic and narrative retrospective of the memorial service of the late Nicholas Nii Adamma Ammah alias Opanin Kwame Darko, held on 30-03-2019 at All Souls' Chapel, Lashibi Funeral Home."
  image="/images/portfolio/nicholas-nii-adamma/01-casket-kente-tribute.jpg"
  imageAlt="Casket draped in Kente cloth with floral tributes at Lashibi Funeral Home"
>
  <Header />

  <main>
    <!-- Breadcrumb -->
    <nav class="breadcrumb container" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><span class="sep">/</span><a href="/portfolio">Portfolio</a></li>
        <li><span class="sep">/</span><span aria-current="page">Nicholas Nii Adamma Ammah</span></li>
      </ol>
    </nav>

    <!-- Case Study Hero -->
    <header class="case-hero">
      <div class="case-hero__bg">
        <img
          src="/images/portfolio/nicholas-nii-adamma/01-casket-kente-tribute.jpg"
          alt="Altar tribute for the late Nicholas Nii Adamma Ammah"
          width="1800"
          height="900"
          fetchpriority="high"
        />
        <div class="case-hero__overlay"></div>
      </div>

      <div class="case-hero__content container">
        <p class="script case-hero__script">Memorial Retrospective</p>
        <span class="case-hero__tag">Full Memorial Service & Gathering</span>
        <h1 class="case-hero__title">
          The Memorial Service of the Late Nicholas Nii Adamma Ammah
        </h1>
        <p class="case-hero__alias">
          Alias <strong>Opanin Kwame Darko</strong> &middot; 30-03-2019 &middot; Lashibi Funeral Home, Accra
        </p>
      </div>
    </header>

    <!-- Key Facts Strip -->
    <section class="facts-strip">
      <div class="container facts-strip__grid">
        <div class="fact-card">
          <span class="fact-label">Date of Service</span>
          <strong class="fact-val">30th March, 2019</strong>
        </div>
        <div class="fact-card">
          <span class="fact-label">Service Venue</span>
          <strong class="fact-val">All Souls' Chapel, Lashibi Funeral Home</strong>
        </div>
        <div class="fact-card">
          <span class="fact-label">Location</span>
          <strong class="fact-val">Lashibi / Tema, Greater Accra</strong>
        </div>
        <div class="fact-card">
          <span class="fact-label">Scope of Care</span>
          <strong class="fact-val">Full Coordination, Casket Drapery, Floral Artistry & Literature</strong>
        </div>
      </div>
    </section>

    <!-- Narrative & Story Section -->
    <section class="case-narrative container">
      <div class="narrative-grid">
        <div class="narrative-main">
          <div class="section-badge">Service Retrospective</div>
          <h2>Celebrating a beloved patriarch with poise and cultural dignity</h2>
          <p class="lead">
            On Saturday, 30th March 2019, family, friends, elders, and well-wishers gathered at the
            All Souls' Chapel of the Lashibi Funeral Home to celebrate the transition and thanksgiving
            service of the late Nicholas Nii Adamma, affectionately known as Opanin Kwame Darko.
          </p>
          <p>
            The gathering honored a life rooted in family stewardship, integrity, and warmth. Every detail of
            the morning service was planned to balance deep Christian reverence with authentic Ghanaian traditional
            symbolism, ensuring that the bereaved family was spared logistical anxieties while providing a peaceful,
            harmonious environment for remembrance.
          </p>

          <div class="narrative-highlights">
            <div class="highlight-box">
              <h3>Ceremonial Kente Drapery & Florals</h3>
              <p>
                In reverence to the deceased’s senior standing as a beloved elder, the casket was draped in rich, hand-woven
                Ghanaian Kente cloth featuring vibrant gold and orange geometric motifs. The centerpiece was crowned by
                an exquisite cascading arrangement of crisp white roses, lilies, and vibrant monstera foliage, symbolizing
                eternal peace and life's enduring legacy.
              </p>
            </div>

            <div class="highlight-box">
              <h3>Chapel Protocol & Order of Service</h3>
              <p>
                The proceedings inside All Souls' Chapel unfolded with meticulous pacing. From the processional hymn
                and opening prayers to tribute readings and the sermon delivered from the wooden lectern, each segment
                afforded the family dedicated moments of reflection and collective song.
              </p>
            </div>

            <div class="highlight-box">
              <h3>Keepsake Memorial Literature</h3>
              <p>
                Every mourner received a customized commemorative brochure containing the biography, photo timelines,
                hymns, and family tributes. The design provided an enduring heirloom that attendees could take home
                to cherish the memory of Opanin Kwame Darko.
              </p>
            </div>
          </div>
        </div>

        <aside class="narrative-sidebar">
          <div class="sidebar-card">
            <h3>Service Information</h3>
            <ul class="meta-list">
              <li>
                <span class="meta-title">Honoree</span>
                <span class="meta-desc">Nicholas Nii Adamma (Opanin Kwame Darko)</span>
              </li>
              <li>
                <span class="meta-title">Service Date</span>
                <span class="meta-desc">Saturday, 30 March 2019</span>
              </li>
              <li>
                <span class="meta-title">Venue</span>
                <span class="meta-desc">All Souls' Chapel, Lashibi Funeral Home</span>
              </li>
              <li>
                <span class="meta-title">Dress Code</span>
                <span class="meta-desc">Celebratory White / Black & White</span>
              </li>
              <li>
                <span class="meta-title">Services Provided</span>
                <span class="meta-desc">
                  &bull; Venue & Chapel Setup<br />
                  &bull; Casket Kente Styling<br />
                  &bull; Altar Floral Installations<br />
                  &bull; Memorial Brochure Curation<br />
                  &bull; Cortege & Escort Protocol
                </span>
              </li>
            </ul>

            <div class="sidebar-cta">
              <p>Need support arranging a dignified memorial service?</p>
              <a href="/book" class="btn btn--peach btn--full">Book Consultation</a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- Full Photo Gallery Section -->
    <section class="case-gallery">
      <div class="container">
        <div class="case-gallery__header">
          <p class="eyebrow">Visual Documentation</p>
          <h2>Memorial Gallery & Archival Moments</h2>
          <p class="gallery-sub">
            Tap any image to inspect it in high resolution. Descriptive placeholders are provided below each photograph
            to record specific family memories, floral notes, and liturgical moments.
          </p>
        </div>

        <div class="gallery-grid" id="galleryGrid">
          {
            galleryImages.map((img, idx) => (
              <figure
                class={`gallery-card ${img.aspect === 'portrait' ? 'gallery-card--portrait' : 'gallery-card--wide'}`}
                data-index={idx}
              >
                <div class="gallery-card__image-container">
                  <img
                    src={img.src}
                    alt={img.description}
                    loading={idx < 3 ? 'eager' : 'lazy'}
                    width="900"
                    height="600"
                  />
                  <span class="gallery-card__tag">{img.tag}</span>
                  <button
                    type="button"
                    class="gallery-card__zoom-btn"
                    aria-label={`Enlarge photo: ${img.title}`}
                    data-zoom-idx={idx}
                  >
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      <line x1="11" y1="8" x2="11" y2="14"></line>
                      <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                  </button>
                </div>

                <figcaption class="gallery-card__caption">
                  <div class="gallery-card__header-line">
                    <span class="gallery-card__num">0{idx + 1}</span>
                    <h3 class="gallery-card__title">{img.title}</h3>
                  </div>
                  <p class="gallery-card__desc">{img.description}</p>
                  <div class="gallery-card__placeholder">
                    <span class="placeholder-badge">Archival Note</span>
                    <p>{img.placeholderNotes}</p>
                  </div>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-hidden="true" tabindex="-1">
      <div class="lightbox__overlay" id="lightboxOverlay"></div>
      <div class="lightbox__container">
        <button type="button" class="lightbox__close" id="lightboxClose" aria-label="Close image viewer">
          &times;
        </button>

        <button type="button" class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" aria-label="Previous photo">
          &#8249;
        </button>
        <button type="button" class="lightbox__nav lightbox__nav--next" id="lightboxNext" aria-label="Next photo">
          &#8250;
        </button>

        <div class="lightbox__content">
          <div class="lightbox__media">
            <img id="lightboxImg" src="" alt="" />
          </div>
          <div class="lightbox__info">
            <div class="lightbox__meta">
              <span id="lightboxTag" class="lightbox__tag"></span>
              <span id="lightboxCounter" class="lightbox__counter"></span>
            </div>
            <h3 id="lightboxTitle" class="lightbox__title"></h3>
            <p id="lightboxDesc" class="lightbox__desc"></p>
            <div class="lightbox__notes-wrap">
              <span class="placeholder-badge">Archival Details</span>
              <p id="lightboxNotes" class="lightbox__notes"></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Footer -->
    <section class="case-footer container">
      <div class="case-footer__box">
        <div>
          <p class="eyebrow">Explore Further</p>
          <h2>Plan with serenity, honor with grace</h2>
          <p>
            Let our experienced team manage every logistical and aesthetic detail of your loved one's memorial
            gathering with the dignity they deserve.
          </p>
        </div>
        <div class="case-footer__actions">
          <a href="/portfolio" class="btn btn--outline">&larr; Back to Portfolio</a>
          <a href="/book" class="btn btn--peach">Book Consultation</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Breadcrumbs */
  .breadcrumb {
    padding: 1.5rem 0 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .breadcrumb a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-charcoal);
  }

  .breadcrumb .sep {
    color: var(--color-line);
    margin: 0 0.2rem;
  }

  .breadcrumb [aria-current='page'] {
    color: var(--color-charcoal);
    font-weight: 500;
  }

  /* Hero Section */
  .case-hero {
    position: relative;
    min-height: 60vh;
    display: grid;
    place-items: end stretch;
    color: white;
    overflow: hidden;
    margin-top: 0.5rem;
  }

  .case-hero__bg {
    position: absolute;
    inset: 0;
  }

  .case-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.68) saturate(0.9);
  }

  .case-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(26, 22, 18, 0.4) 0%,
      rgba(26, 22, 18, 0.72) 70%,
      rgba(26, 22, 18, 0.9) 100%
    );
  }

  .case-hero__content {
    position: relative;
    z-index: 1;
    padding: 7rem 0 4rem;
    max-width: 900px;
  }

  .case-hero__script {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    margin: 0 0 0.4rem;
    color: var(--color-blush);
  }

  .case-hero__tag {
    display: inline-block;
    background: rgba(201, 168, 146, 0.35);
    border: 1px solid rgba(232, 213, 196, 0.4);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .case-hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1.15;
    color: #ffffff;
    margin: 0 0 1rem;
    font-weight: 500;
  }

  .case-hero__alias {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    line-height: 1.6;
  }

  .case-hero__alias strong {
    color: #ffffff;
    font-weight: 600;
  }

  /* Facts Strip */
  .facts-strip {
    background: var(--color-white);
    border-bottom: 1px solid var(--color-line);
    padding: 2.25rem 0;
  }

  .facts-strip__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .fact-card {
    border-left: 2px solid var(--color-peach);
    padding-left: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .fact-label {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .fact-val {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-charcoal);
    font-weight: 500;
    line-height: 1.35;
  }

  /* Narrative & Story */
  .case-narrative {
    padding: 5rem 0 4rem;
  }

  .narrative-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 900px) {
    .narrative-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .section-badge {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-peach-deep);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .narrative-main h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1.25;
    color: var(--color-charcoal);
    margin: 0 0 1.5rem;
  }

  .narrative-main .lead {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.8;
    color: var(--color-wood);
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  .narrative-main p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-ink);
    margin-bottom: 1.25rem;
  }

  .narrative-highlights {
    margin-top: 2.75rem;
    display: grid;
    gap: 1.75rem;
  }

  .highlight-box {
    background: var(--color-soft);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-peach);
    padding: 1.75rem 2rem;
    border-radius: 4px;
  }

  .highlight-box h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-charcoal);
    margin: 0 0 0.5rem;
  }

  .highlight-box p {
    font-size: 0.98rem;
    line-height: 1.7;
    margin: 0;
    color: var(--color-wood);
  }

  /* Sidebar */
  .sidebar-card {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    padding: 2.25rem 1.75rem;
    position: sticky;
    top: 6rem;
    box-shadow: var(--shadow-soft);
  }

  .sidebar-card h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-charcoal);
    margin: 0 0 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-line);
  }

  .meta-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: grid;
    gap: 1.15rem;
  }

  .meta-title {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.2rem;
  }

  .meta-desc {
    font-size: 0.95rem;
    color: var(--color-charcoal);
    line-height: 1.5;
  }

  .sidebar-cta {
    background: var(--color-soft);
    padding: 1.25rem;
    text-align: center;
    border: 1px dashed var(--color-peach);
  }

  .sidebar-cta p {
    font-size: 0.88rem;
    color: var(--color-wood);
    margin: 0 0 1rem;
  }

  .btn--full {
    width: 100%;
    text-align: center;
    display: block;
  }

  /* Gallery Section */
  .case-gallery {
    background: var(--color-ivory);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 5rem 0 6rem;
  }

  .case-gallery__header {
    max-width: 760px;
    margin-bottom: 3.5rem;
  }

  .case-gallery__header h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-charcoal);
    margin: 0.4rem 0 1rem;
  }

  .gallery-sub {
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }

  @media (min-width: 720px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-card {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    margin: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(26, 22, 18, 0.08);
  }

  .gallery-card__image-container {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-soft);
    cursor: pointer;
  }

  .gallery-card__image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .gallery-card:hover .gallery-card__image-container img {
    transform: scale(1.04);
  }

  .gallery-card__tag {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    background: rgba(26, 22, 18, 0.75);
