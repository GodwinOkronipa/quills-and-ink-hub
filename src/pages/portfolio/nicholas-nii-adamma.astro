    align-items: center;
    gap: 2rem;
  }

  .case-footer__box h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    color: var(--color-charcoal);
    margin: 0.35rem 0 0.6rem;
  }

  .case-footer__box p {
    font-size: 1.05rem;
    color: var(--color-muted);
    max-width: 580px;
    margin: 0;
  }

  .case-footer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn--outline {
    background: transparent;
    border: 1px solid var(--color-charcoal);
    color: var(--color-charcoal);
  }

  .btn--outline:hover {
    background: var(--color-charcoal);
    color: #fff;
  }
</style>

<script>
  // Client-side Lightbox Script
  const galleryData = [
    {
      title: 'Casket Drapery & Floral Artistry',
      tag: 'Floral Artistry & Drapery',
      src: '/images/portfolio/nicholas-nii-adamma/01-casket-kente-tribute.jpg',
      description:
        'The casket of the late Nicholas Nii Adamma draped in authentic woven Ghanaian Kente cloth, adorned with lush monstera foliage and pristine white floral wreath arrangements at the altar.',
      notes:
        'Placeholder description: Detailed floral arrangement breakdown, choice of kente pattern, and altar positioning prepared for the thanksgiving service.',
    },
    {
      title: "All Souls' Chapel Grounds",
      tag: 'Venue & Grounds',
      src: '/images/portfolio/nicholas-nii-adamma/02-all-souls-chapel-exterior.jpg',
      description:
        "Exterior perspective of All Souls' Chapel Interdenominational at Lashibi Funeral Home under clear skies, welcoming morning guests and family members to the solemn service.",
      notes:
        'Placeholder description: Lashibi Funeral Home All Souls\' Chapel architecture, guest arrival staging, and serene surrounding landscape.',
    },
    {
      title: 'Sanctuary Gathering & Congregation',
      tag: 'Sanctuary Service',
      src: '/images/portfolio/nicholas-nii-adamma/03-chapel-sanctuary-congregation.jpg',
      description:
        'An expansive view from the sanctuary platform capturing the congregation seated in traditional white funeral attire along the central red aisle runner.',
      notes:
        'Placeholder description: Chapel capacity management, seating arrangement for family and sympathizers, and sanctuary atmosphere.',
    },
    {
      title: 'Scripture Exhortation & Clergy Officiation',
      tag: 'Liturgical Officiation',
      src: '/images/portfolio/nicholas-nii-adamma/04-officiating-clergy-sermon.jpg',
      description:
        'The officiating clergy delivering the sermon, prayer of thanksgiving, and scripture readings from the timber sanctuary lectern.',
      notes:
        'Placeholder description: Order of worship, clergy coordination, sermon excerpt, and pastoral prayers.',
    },
    {
      title: 'Family Elders & Dignitaries in Reflection',
      tag: 'Family Protocol',
      src: '/images/portfolio/nicholas-nii-adamma/05-family-elders-procession.jpg',
      description:
        'Family heads and elders of the widow seated in the front rows, dressed in ceremonial white woven cloths in solemn remembrance.',
      notes:
        'Placeholder description: Seating order for chief mourners, family heads, and visiting community elders.',
    },
    {
      title: 'Memorial Keepsake Brochure in Hand',
      tag: 'Literature & Print',
      src: '/images/portfolio/nicholas-nii-adamma/06-congregation-memorial-brochure.jpg',
      description:
        'Mourners holding the official memorial service booklet, featuring the patriarch’s life story, tribute compilation, and order of service hymns.',
      notes:
        'Placeholder description: Print design specifications, commemorative booklet layout, and tribute reading facilitation.',
    },
    {
      title: 'Family Matriarchs & Chief Mourners',
      tag: 'Family Protocol',
      src: '/images/portfolio/nicholas-nii-adamma/07-chief-mourners-family.jpg',
      description:
        'Family matriarchs and chief mourners dressed in white lace attire and headwraps, holding solemn vigil during the farewell tributes.',
      notes:
        'Placeholder description: Close family portrait, ceremonial headwraps and white memorial attire symbolism.',
    },
    {
      title: 'Chapel Verandah & Shaded Walkways',
      tag: 'Venue Coordination',
      src: '/images/portfolio/nicholas-nii-adamma/08-chapel-verandah-walkway.jpg',
      description:
        "Covered walkways and shaded outdoor verandah at All Souls' Chapel accommodating mourners in a tranquil outdoor setting.",
      notes:
        'Placeholder description: Overflow seating protocol, audio relay across the verandah, and guest comfort measures.',
    },
    {
      title: 'Cortege Assembly & Grounds Escort',
      tag: 'Cortege & Logistics',
      src: '/images/portfolio/nicholas-nii-adamma/09-cortege-grounds-escort.jpg',
      description:
        'Vehicle cortege parking and security protocol escort stationed on the funeral home driveway before the committal journey.',
      notes:
        'Placeholder description: Procession vehicle staging, traffic coordination, and escort protocols to the cemetery.',
    },
  ];

  let currentIndex = 0;

  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const overlay = document.getElementById('lightboxOverlay') as HTMLElement;
  const closeBtn = document.getElementById('lightboxClose') as HTMLElement;
  const prevBtn = document.getElementById('lightboxPrev') as HTMLElement;
  const nextBtn = document.getElementById('lightboxNext') as HTMLElement;

  const imgEl = document.getElementById('lightboxImg') as HTMLImageElement;
  const titleEl = document.getElementById('lightboxTitle') as HTMLElement;
  const tagEl = document.getElementById('lightboxTag') as HTMLElement;
  const counterEl = document.getElementById('lightboxCounter') as HTMLElement;
  const descEl = document.getElementById('lightboxDesc') as HTMLElement;
  const notesEl = document.getElementById('lightboxNotes') as HTMLElement;

  function updateLightbox(idx: number) {
    if (idx < 0) idx = galleryData.length - 1;
    if (idx >= galleryData.length) idx = 0;
    currentIndex = idx;

    const data = galleryData[currentIndex];
    imgEl.src = data.src;
    imgEl.alt = data.title;
    titleEl.textContent = data.title;
    tagEl.textContent = data.tag;
    counterEl.textContent = `${currentIndex + 1} of ${galleryData.length}`;
    descEl.textContent = data.description;
    notesEl.textContent = data.notes;
  }

  function openLightbox(idx: number) {
    updateLightbox(idx);
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Bind clicks
  document.querySelectorAll<HTMLElement>('.gallery-card__image-container').forEach((el) => {
    el.addEventListener('click', () => {
      const parent = el.closest('.gallery-card') as HTMLElement;
      if (parent && parent.dataset.index) {
        openLightbox(parseInt(parent.dataset.index, 10));
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.gallery-card__zoom-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = btn.dataset.zoomIdx;
      if (idx !== undefined) {
        openLightbox(parseInt(idx, 10));
      }
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  overlay?.addEventListener('click', closeLightbox);

  prevBtn?.addEventListener('click', () => {
    updateLightbox(currentIndex - 1);
  });

  nextBtn?.addEventListener('click', () => {
    updateLightbox(currentIndex + 1);
  });

  window.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') updateLightbox(currentIndex - 1);
    if (e.key === 'ArrowRight') updateLightbox(currentIndex + 1);
  });
</script>
