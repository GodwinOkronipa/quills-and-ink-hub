    color: var(--color-charcoal);
  }

  .btn--outline:hover {
    background: var(--color-charcoal);
    color: #fff;
  }
</style>

<script>
  // Client-side Lightbox Script
  const galleryData = [
    {
      title: 'Memorial Portrait & Candlelight Altar',
      tag: 'Altar & Memorial Shrine',
      src: '/images/portfolio/william-dowridge-adu-asare/01-memorial-portrait-registry.jpg',
      description:
        'The commemorative portrait of the late William Dowridge Adu-Asare Snr presented on a red-draped ceremonial table with warm candle illumination and the official condolence register.',
      notes:
        'Intimate memorial table staging, ambient pillar candles, and guestbook placement for arriving family, colleagues, and church brethren.',
    },
    {
      title: 'Official Funeral Announcement & Schedule of Rites',
      tag: 'Literature & Announcements',
      src: '/images/portfolio/william-dowridge-adu-asare/02-funeral-invitation-arrangements.jpg',
      description:
        'The official commemorative funeral invitation outlining the schedule of rites from the laying in state and burial service at The Church in Accra, Achimota to the final funeral rites at Dreamz & Memoriez Events Garden.',
      notes:
        'Graphic design typography, gold-accented layout, event coordination itinerary, and dress code guidance for Saturday and Sunday rites.',
    },
    {
      title: 'Garden Reception & Dignitary Greetings',
      tag: 'Venue & Protocol',
      src: '/images/portfolio/william-dowridge-adu-asare/03-garden-reception-arrival.jpg',
      description:
        'Family heads, dignitaries, and sympathizers arriving under the shaded canopy at Dreamz and Memoriez Events Garden, greeted by family elders.',
      notes:
        'Canopy drapery, lush garden venue staging, guest arrival reception, and protocol flow.',
    },
    {
      title: 'Condolence Register & Protocol Desk',
      tag: 'Secretariat & Protocol',
      src: '/images/portfolio/william-dowridge-adu-asare/04-donation-registry-protocol.jpg',
      description:
        'The memorial coordination desk receiving sympathizers, managing formal donation recordings (Nsawa), and logging heartfelt tribute messages.',
      notes:
        'Traditional Ghanaian funeral donation administration, receipting protocol, and secure cashbox management.',
    },
    {
      title: 'Family Announcements & Word of Appreciation',
      tag: 'Family Leadership',
      src: '/images/portfolio/william-dowridge-adu-asare/05-family-spokesperson-announcements.jpg',
      description:
        'The family elder and spokesperson addressing the gathered mourners from the microphone, flanked by the family matriarch and elders.',
      notes:
        'Family acknowledgments, announcement of committal arrangements, and formal vote of thanks to guests and well-wishers.',
    },
    {
      title: 'Mourners Gathered in Solemn Remembrance',
      tag: 'Memorial Gathering',
      src: '/images/portfolio/william-dowridge-adu-asare/06-memorial-canopy-congregation.jpg',
      description:
        'A solemn assembly of extended family, friends, and sympathizers seated under the red and black canopy drapery during the remembrance rites.',
      notes:
        'Seating capacity arrangement, natural shade integration, and dignified ambiance for reflection and prayer.',
    },
    {
      title: 'Eulogy & Farewell Tribute Delivery',
      tag: 'Tributes & Reflections',
      src: '/images/portfolio/william-dowridge-adu-asare/07-eulogy-tribute-delivery.jpg',
      description:
        'A poignant personal tribute and eulogy delivered at the microphone honoring the life, virtues, and lasting legacy of William Dowridge Adu-Asare Snr.',
      notes:
        'Microphone audio coordination, spoken tribute facilitation, and emotional family support during readings.',
    },
    {
      title: 'Chief Mourners & Widow in Reflection',
      tag: 'Family Protocol',
      src: '/images/portfolio/william-dowridge-adu-asare/08-chief-mourners-vigil.jpg',
      description:
        'The bereaved widow, matriarchs, and chief mourners standing in traditional black memorial mourning cloths during prayers and songs.',
      notes:
        'Chief mourners designated seating area, cultural mourning attire etiquette, and pastoral comfort.',
    },
    {
      title: 'Family Secretariat Beneath Red & Black Canopies',
      tag: 'Venue Coordination',
      src: '/images/portfolio/william-dowridge-adu-asare/09-family-protocol-drapery.jpg',
      description:
        'Family members gathered in unity behind the central coordination table framed by traditional red and black canopy drapery.',
      notes:
        'Canopy ceiling draping with red and black Ghanaian funeral colors, coordinating staff, and hospitality support.',
    },
    {
      title: 'Secretariat Attendants & Tributes Logging',
      tag: 'Secretariat & Records',
      src: '/images/portfolio/william-dowridge-adu-asare/10-condolence-desk-recording.jpg',
      description:
        'Protocol attendants in commemorative memorial t-shirts diligently recording attendee sympathy messages and condolence tokens.',
      notes:
        'Branded memorial attire, structured registry ledger, and attendee assistance during the funeral rites.',
    },
  ];

  let currentIndex = 0;

  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const overlay = document.getElementById('lightboxOverlay') as HTMLElement;
  const closeBtn = document.getElementById('lightboxClose') as HTMLElement;
  const prevBtn = document.getElementById('lightboxPrev') as HTMLElement;
  const nextBtn = document.getElementById('lightboxNext') as HTMLElement;

  const imgEl = document.getElementById('lightboxImg') as HTMLImageElement;
  const titleEl = document.getElementById('lightboxTitle') as HTMLElement;
  const tagEl = document.getElementById('lightboxTag') as HTMLElement;
  const counterEl = document.getElementById('lightboxCounter') as HTMLElement;
  const descEl = document.getElementById('lightboxDesc') as HTMLElement;
  const notesEl = document.getElementById('lightboxNotes') as HTMLElement;

  function updateLightbox(idx: number) {
    if (idx < 0) idx = galleryData.length - 1;
    if (idx >= galleryData.length) idx = 0;
    currentIndex = idx;

    const data = galleryData[currentIndex];
    imgEl.src = data.src;
    imgEl.alt = data.title;
    titleEl.textContent = data.title;
    tagEl.textContent = data.tag;
    counterEl.textContent = `${currentIndex + 1} of ${galleryData.length}`;
    descEl.textContent = data.description;
    notesEl.textContent = data.notes;
  }

  function openLightbox(idx: number) {
    updateLightbox(idx);
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Bind clicks
  document.querySelectorAll<HTMLElement>('.gallery-card__image-container').forEach((el) => {
    el.addEventListener('click', () => {
      const parent = el.closest('.gallery-card') as HTMLElement;
      if (parent && parent.dataset.index) {
        openLightbox(parseInt(parent.dataset.index, 10));
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.gallery-card__zoom-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = btn.dataset.zoomIdx;
      if (idx !== undefined) {
        openLightbox(parseInt(idx, 10));
      }
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  overlay?.addEventListener('click', closeLightbox);

  prevBtn?.addEventListener('click', () => {
    updateLightbox(currentIndex - 1);
  });

  nextBtn?.addEventListener('click', () => {
    updateLightbox(currentIndex + 1);
  });

  window.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') updateLightbox(currentIndex - 1);
    if (e.key === 'ArrowRight') updateLightbox(currentIndex + 1);
  });
</script>
