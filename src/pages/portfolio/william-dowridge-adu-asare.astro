---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const galleryImages = [
  {
    id: 'memorial-portrait',
    title: 'Memorial Portrait & Candlelight Altar',
    tag: 'Altar & Memorial Shrine',
    src: '/images/portfolio/william-dowridge-adu-asare/01-memorial-portrait-registry.jpg',
    aspect: 'wide',
    description:
      'The commemorative portrait of the late William Dowridge Adu-Asare Snr presented on a red-draped ceremonial table with warm candle illumination and the official condolence register.',
    placeholderNotes:
      'Intimate memorial table staging, ambient pillar candles, and guestbook placement for arriving family, colleagues, and church brethren.',
  },
  {
    id: 'funeral-invitation',
    title: 'Official Funeral Announcement & Schedule of Rites',
    tag: 'Literature & Announcements',
    src: '/images/portfolio/william-dowridge-adu-asare/02-funeral-invitation-arrangements.jpg',
    aspect: 'wide',
    description:
      'The official commemorative funeral invitation outlining the schedule of rites from the laying in state and burial service at The Church in Accra, Achimota to the final funeral rites at Dreamz & Memoriez Events Garden.',
    placeholderNotes:
      'Graphic design typography, gold-accented layout, event coordination itinerary, and dress code guidance for Saturday and Sunday rites.',
  },
  {
    id: 'garden-arrival',
    title: 'Garden Reception & Dignitary Greetings',
    tag: 'Venue & Protocol',
    src: '/images/portfolio/william-dowridge-adu-asare/03-garden-reception-arrival.jpg',
    aspect: 'wide',
    description:
      'Family heads, dignitaries, and sympathizers arriving under the shaded canopy at Dreamz and Memoriez Events Garden, greeted by family elders.',
    placeholderNotes:
      'Canopy drapery, lush garden venue staging, guest arrival reception, and protocol flow.',
  },
  {
    id: 'donation-protocol',
    title: 'Condolence Register & Protocol Desk',
    tag: 'Secretariat & Protocol',
    src: '/images/portfolio/william-dowridge-adu-asare/04-donation-registry-protocol.jpg',
    aspect: 'wide',
    description:
      'The memorial coordination desk receiving sympathizers, managing formal donation recordings (Nsawa), and logging heartfelt tribute messages.',
    placeholderNotes:
      'Traditional Ghanaian funeral donation administration, receipting protocol, and secure cashbox management.',
  },
  {
    id: 'family-spokesperson',
    title: 'Family Announcements & Word of Appreciation',
    tag: 'Family Leadership',
    src: '/images/portfolio/william-dowridge-adu-asare/05-family-spokesperson-announcements.jpg',
    aspect: 'wide',
    description:
      'The family elder and spokesperson addressing the gathered mourners from the microphone, flanked by the family matriarch and elders.',
    placeholderNotes:
      'Family acknowledgments, announcement of committal arrangements, and formal vote of thanks to guests and well-wishers.',
  },
  {
    id: 'memorial-congregation',
    title: 'Mourners Gathered in Solemn Remembrance',
    tag: 'Memorial Gathering',
    src: '/images/portfolio/william-dowridge-adu-asare/06-memorial-canopy-congregation.jpg',
    aspect: 'wide',
    description:
      'A solemn assembly of extended family, friends, and sympathizers seated under the red and black canopy drapery during the remembrance rites.',
    placeholderNotes:
      'Seating capacity arrangement, natural shade integration, and dignified ambiance for reflection and prayer.',
  },
  {
    id: 'eulogy-tribute',
    title: 'Eulogy & Farewell Tribute Delivery',
    tag: 'Tributes & Reflections',
    src: '/images/portfolio/william-dowridge-adu-asare/07-eulogy-tribute-delivery.jpg',
    aspect: 'portrait',
    description:
      'A poignant personal tribute and eulogy delivered at the microphone honoring the life, virtues, and lasting legacy of William Dowridge Adu-Asare Snr.',
    placeholderNotes:
      'Microphone audio coordination, spoken tribute facilitation, and emotional family support during readings.',
  },
  {
    id: 'chief-mourners',
    title: 'Chief Mourners & Widow in Reflection',
    tag: 'Family Protocol',
    src: '/images/portfolio/william-dowridge-adu-asare/08-chief-mourners-vigil.jpg',
    aspect: 'wide',
    description:
      'The bereaved widow, matriarchs, and chief mourners standing in traditional black memorial mourning cloths during prayers and songs.',
    placeholderNotes:
      'Chief mourners designated seating area, cultural mourning attire etiquette, and pastoral comfort.',
  },
  {
    id: 'family-drapery',
    title: 'Family Secretariat Beneath Red & Black Canopies',
    tag: 'Venue Coordination',
    src: '/images/portfolio/william-dowridge-adu-asare/09-family-protocol-drapery.jpg',
    aspect: 'wide',
    description:
      'Family members gathered in unity behind the central coordination table framed by traditional red and black canopy drapery.',
    placeholderNotes:
      'Canopy ceiling draping with red and black Ghanaian funeral colors, coordinating staff, and hospitality support.',
  },
  {
    id: 'condolence-recording',
    title: 'Secretariat Attendants & Tributes Logging',
    tag: 'Secretariat & Records',
    src: '/images/portfolio/william-dowridge-adu-asare/10-condolence-desk-recording.jpg',
    aspect: 'wide',
    description:
      'Protocol attendants in commemorative memorial t-shirts diligently recording attendee sympathy messages and condolence tokens.',
    placeholderNotes:
      'Branded memorial attire, structured registry ledger, and attendee assistance during the funeral rites.',
  },
];
---

<BaseLayout
  title="Memorial Service of the Late William Dowridge Adu-Asare Snr (Kwame Adu) | Portfolio | Quills and Ink Hub"
  description="A photographic and narrative retrospective of the memorial service and funeral rites of the late William Dowridge Adu-Asare Snr (Kwame Adu, 1960–2026), held at The Church in Accra and Dreamz & Memoriez Events Garden, Achimota."
  image="/images/portfolio/william-dowridge-adu-asare/01-memorial-portrait-registry.jpg"
  imageAlt="Memorial portrait and candlelight tribute for the late William Dowridge Adu-Asare Snr"
>
  <Header />

  <main>
    <!-- Breadcrumb -->
    <nav class="breadcrumb container" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><span class="sep">/</span><a href="/portfolio">Portfolio</a></li>
        <li><span class="sep">/</span><span aria-current="page">William Dowridge Adu-Asare Snr</span></li>
      </ol>
    </nav>

    <!-- Case Study Hero -->
    <header class="case-hero">
      <div class="case-hero__bg">
        <img
          src="/images/portfolio/william-dowridge-adu-asare/01-memorial-portrait-registry.jpg"
          alt="Memorial altar and portrait of the late William Dowridge Adu-Asare Snr"
          width="1800"
          height="900"
          fetchpriority="high"
        />
        <div class="case-hero__overlay"></div>
      </div>

      <div class="case-hero__content container">
        <p class="script case-hero__script">Memorial Retrospective</p>
        <span class="case-hero__tag">Full Memorial Service & Gathering</span>
        <h1 class="case-hero__title">
          The Memorial Service of the Late William Dowridge Adu-Asare Snr
        </h1>
        <p class="case-hero__alias">
          Affectionately known as <strong>Kwame Adu</strong> &middot; 1960 &ndash; 2026 &middot; Achimota &amp; Amrahia-Otinibi, Greater Accra
        </p>
      </div>
    </header>

    <!-- Key Facts Strip -->
    <section class="facts-strip">
      <div class="container facts-strip__grid">
        <div class="fact-card">
          <span class="fact-label">Dates of Service</span>
          <strong class="fact-val">Saturday 2nd &amp; Sunday 3rd May, 2026</strong>
        </div>
        <div class="fact-card">
          <span class="fact-label">Service Venues</span>
          <strong class="fact-val">The Church in Accra &amp; Dreamz and Memoriez Events Garden</strong>
        </div>
        <div class="fact-card">
          <span class="fact-label">Locations</span>
          <strong class="fact-val">Achimota &amp; Amrahia-Otinibi, Greater Accra</strong>
        </div>
        <div class="fact-card">
          <span class="fact-label">Scope of Care</span>
          <strong class="fact-val">Full Event Coordination, Protocol Secretariat, Floral Altar &amp; Tributes</strong>
        </div>
      </div>
    </section>

    <!-- Narrative & Story Section -->
    <section class="case-narrative container">
      <div class="narrative-grid">
        <div class="narrative-main">
          <div class="section-badge">Service Retrospective</div>
          <h2>Honoring a cherished patriarch with poise, reverence, and cultural grace</h2>
          <p class="lead">
            On Saturday, 2nd May and Sunday, 3rd May 2026, family members, colleagues, church brethren, and community
            sympathizers assembled in Achimota and Amrahia-Otinibi to celebrate the life and solemn transition of the late
            William Dowridge Adu-Asare Snr, affectionately remembered by all as Kwame Adu (1960–2026).
          </p>
          <p>
            The memorial program was orchestrated to harmonize deep Christian liturgical reverence with warm, respectful Ghanaian
            customs. From the early morning laying-in-state and burial service at The Church in Accra near Kingsby Roundabout,
            to the expansive final funeral gathering at Dreamz and Memoriez Events Garden, every touchpoint was curated to bring
            comfort to the family and afford guests an orderly, reflective experience.
          </p>

          <div class="narrative-highlights">
            <div class="highlight-box">
              <h3>Memorial Altar &amp; Candlelight Sanctuary</h3>
              <p>
                A designated focal shrine featuring an elegant framed portrait of William Dowridge Adu-Asare Snr was staged
                upon richly draped ceremonial crimson linens. Flanked by gentle glowing candlelight and a leather-bound condolence
                register, it offered each arriving mourner an immediate sanctuary for private reflection and prayer.
              </p>
            </div>

            <div class="highlight-box">
              <h3>Protocol Secretariat &amp; Donation Desk (Nsawa)</h3>
              <p>
                To ease administrative stress during high attendance hours, our secretariat deployed a dedicated protocol desk
                manned by trained attendants in commemorative memorial attire. Sympathy contributions, guest arrivals, and handwritten
                expressions of condolence were methodically organized and recorded with complete transparency.
              </p>
            </div>

            <div class="highlight-box">
              <h3>Eulogy Readings &amp; Family Tributes</h3>
              <p>
                The memorial gathering under the garden canopies was punctuated by heartfelt spoken tributes. Family members,
                children, and church leaders took to the lectern to recount his generosity, firm counsel, and warm smile,
                creating an atmosphere of profound gratitude and enduring family solidarity.
              </p>
            </div>

            <div class="highlight-box">
              <h3>Thanksgiving Service &amp; Amrahia-Otinibi Reception</h3>
              <p>
                The weekend concluded on Sunday morning with a joyous thanksgiving service at The Church in Accra followed
                by a peaceful family hospitality gathering at the family residence along Honey Crisp Street in Amrahia-Otinibi,
                celebrating a life well-lived in celebratory black and white attire.
              </p>
            </div>
          </div>
        </div>

        <aside class="narrative-sidebar">
          <div class="sidebar-card">
            <h3>Service Information</h3>
            <ul class="meta-list">
              <li>
                <span class="meta-title">Honoree</span>
                <span class="meta-desc">William Dowridge Adu-Asare Snr (Kwame Adu)</span>
              </li>
              <li>
                <span class="meta-title">Life Dates</span>
                <span class="meta-desc">1960 &ndash; 2026 (66 Years)</span>
              </li>
              <li>
                <span class="meta-title">Service Dates</span>
                <span class="meta-desc">Saturday, 2nd May &amp; Sunday, 3rd May 2026</span>
              </li>
              <li>
                <span class="meta-title">Church Venue</span>
                <span class="meta-desc">The Church in Accra, Achimota near Kingsby Roundabout</span>
              </li>
              <li>
                <span class="meta-title">Funeral Grounds</span>
                <span class="meta-desc">Dreamz &amp; Memoriez Events Garden, Achimota</span>
              </li>
              <li>
                <span class="meta-title">Thanksgiving Residence</span>
                <span class="meta-desc">V137 Honey Crisp Street, Amrahia-Otinibi</span>
              </li>
              <li>
                <span class="meta-title">Attire Protocol</span>
                <span class="meta-desc">
                  &bull; Saturday: Black / Red<br />
                  &bull; Sunday: Black &amp; White
                </span>
              </li>
              <li>
                <span class="meta-title">Services Provided</span>
                <span class="meta-desc">
                  &bull; Church &amp; Garden Venue Coordination<br />
                  &bull; Memorial Altar &amp; Candlelight Staging<br />
                  &bull; Protocol Secretariat &amp; Registry Desk<br />
                  &bull; Order of Service &amp; Spoken Tribute Audio<br />
                  &bull; Thanksgiving Reception Logistics
                </span>
              </li>
            </ul>

            <div class="sidebar-cta">
              <p>Download the official memorial tribute booklet and order of service:</p>
              <a
                href="/downloads/william-dowridge-adu-asare-brochure.pdf"
                class="btn btn--outline btn--full"
                target="_blank"
                rel="noopener noreferrer"
                style="margin-bottom: 0.75rem;"
              >
                📄 Download Memorial Brochure (PDF)
              </a>
              <p style="margin-top: 1rem;">Need dedicated guidance arranging a memorial service in Ghana?</p>
              <a href="/book" class="btn btn--peach btn--full">Book Consultation</a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- Full Photo Gallery Section -->
    <section class="case-gallery">
      <div class="container">
        <div class="case-gallery__header">
          <p class="eyebrow">Visual Documentation</p>
          <h2>Memorial Gallery &amp; Archival Moments</h2>
          <p class="gallery-sub">
            Tap any photograph to view in high resolution. Detailed archival notes are preserved alongside each image to
            commemorate specific liturgical rituals, protocol milestones, and family memories.
          </p>
        </div>

        <div class="gallery-grid" id="galleryGrid">
          {
            galleryImages.map((img, idx) => (
              <figure
                class={`gallery-card ${img.aspect === 'portrait' ? 'gallery-card--portrait' : 'gallery-card--wide'}`}
                data-index={idx}
              >
                <div class="gallery-card__image-container">
                  <img
                    src={img.src}
                    alt={img.description}
                    loading={idx < 3 ? 'eager' : 'lazy'}
                    width="900"
                    height="600"
                  />
                  <span class="gallery-card__tag">{img.tag}</span>
                  <button
                    type="button"
                    class="gallery-card__zoom-btn"
                    aria-label={`Enlarge photo: ${img.title}`}
                    data-zoom-idx={idx}
                  >
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      <line x1="11" y1="8" x2="11" y2="14"></line>
                      <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                  </button>
                </div>

                <figcaption class="gallery-card__caption">
                  <div class="gallery-card__header-line">
                    <span class="gallery-card__num">{idx + 1 < 10 ? `0${idx + 1}` : idx + 1}</span>
                    <h3 class="gallery-card__title">{img.title}</h3>
                  </div>
                  <p class="gallery-card__desc">{img.description}</p>
                  <div class="gallery-card__placeholder">
                    <span class="placeholder-badge">Archival Note</span>
                    <p>{img.placeholderNotes}</p>
                  </div>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-hidden="true" tabindex="-1">
      <div class="lightbox__overlay" id="lightboxOverlay"></div>
      <div class="lightbox__container">
        <button type="button" class="lightbox__close" id="lightboxClose" aria-label="Close image viewer">
          &times;
        </button>

        <button type="button" class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" aria-label="Previous photo">
          &#8249;
        </button>
        <button type="button" class="lightbox__nav lightbox__nav--next" id="lightboxNext" aria-label="Next photo">
          &#8250;
        </button>

        <div class="lightbox__content">
          <div class="lightbox__media">
            <img id="lightboxImg" src="" alt="" />
          </div>
          <div class="lightbox__info">
            <div class="lightbox__meta">
              <span id="lightboxTag" class="lightbox__tag"></span>
              <span id="lightboxCounter" class="lightbox__counter"></span>
            </div>
            <h3 id="lightboxTitle" class="lightbox__title"></h3>
            <p id="lightboxDesc" class="lightbox__desc"></p>
            <div class="lightbox__notes-wrap">
              <span class="placeholder-badge">Archival Details</span>
              <p id="lightboxNotes" class="lightbox__notes"></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Footer -->
    <section class="case-footer container">
      <div class="case-footer__box">
        <div>
          <p class="eyebrow">Explore Further</p>
          <h2>Plan with serenity, honor with grace</h2>
          <p>
            Let our experienced team manage every logistical and aesthetic detail of your family's memorial
            gathering with the composure and reverence they deserve.
          </p>
        </div>
        <div class="case-footer__actions">
          <a href="/portfolio" class="btn btn--outline">&larr; Back to Portfolio</a>
          <a href="/book" class="btn btn--peach">Book Consultation</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Breadcrumbs */
  .breadcrumb {
    padding: 1.5rem 0 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .breadcrumb a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-charcoal);
  }

  .breadcrumb .sep {
    color: var(--color-line);
    margin: 0 0.2rem;
  }

  .breadcrumb [aria-current='page'] {
    color: var(--color-charcoal);
    font-weight: 500;
  }

  /* Hero Section */
  .case-hero {
    position: relative;
    min-height: 60vh;
    display: grid;
    place-items: end stretch;
    color: white;
    overflow: hidden;
    margin-top: 0.5rem;
  }

  .case-hero__bg {
    position: absolute;
    inset: 0;
  }

  .case-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.68) saturate(0.9);
  }

  .case-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(26, 22, 18, 0.4) 0%,
      rgba(26, 22, 18, 0.72) 70%,
      rgba(26, 22, 18, 0.9) 100%
    );
  }

  .case-hero__content {
    position: relative;
    z-index: 1;
    padding: 7rem 0 4rem;
    max-width: 900px;
  }

  .case-hero__script {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    margin: 0 0 0.4rem;
    color: var(--color-blush);
  }

  .case-hero__tag {
    display: inline-block;
    background: rgba(201, 168, 146, 0.35);
    border: 1px solid rgba(232, 213, 196, 0.4);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .case-hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1.15;
    color: #ffffff;
    margin: 0 0 1rem;
    font-weight: 500;
  }

  .case-hero__alias {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    line-height: 1.6;
  }

  .case-hero__alias strong {
    color: #ffffff;
    font-weight: 600;
  }

  /* Facts Strip */
  .facts-strip {
    background: var(--color-white);
    border-bottom: 1px solid var(--color-line);
    padding: 2.25rem 0;
  }

  .facts-strip__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .fact-card {
    border-left: 2px solid var(--color-peach);
    padding-left: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .fact-label {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .fact-val {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-charcoal);
    font-weight: 500;
    line-height: 1.35;
  }

  /* Narrative & Story */
  .case-narrative {
    padding: 5rem 0 4rem;
  }

  .narrative-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 900px) {
    .narrative-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .section-badge {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-peach-deep);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .narrative-main h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1.25;
    color: var(--color-charcoal);
    margin: 0 0 1.5rem;
  }

  .narrative-main .lead {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.8;
    color: var(--color-wood);
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  .narrative-main p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-ink);
    margin-bottom: 1.25rem;
  }

  .narrative-highlights {
    margin-top: 2.75rem;
    display: grid;
    gap: 1.75rem;
  }

  .highlight-box {
    background: var(--color-soft);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-peach);
    padding: 1.75rem 2rem;
    border-radius: 4px;
  }

  .highlight-box h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-charcoal);
    margin: 0 0 0.5rem;
  }

  .highlight-box p {
    font-size: 0.98rem;
    line-height: 1.7;
    margin: 0;
    color: var(--color-wood);
  }

  /* Sidebar */
  .sidebar-card {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    padding: 2.25rem 1.75rem;
    position: sticky;
    top: 6rem;
    box-shadow: var(--shadow-soft);
  }

  .sidebar-card h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-charcoal);
    margin: 0 0 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-line);
  }

  .meta-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: grid;
    gap: 1.15rem;
  }

  .meta-title {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.2rem;
  }

  .meta-desc {
    font-size: 0.95rem;
    color: var(--color-charcoal);
    line-height: 1.5;
  }

  .sidebar-cta {
    background: var(--color-soft);
    padding: 1.25rem;
    text-align: center;
    border: 1px dashed var(--color-peach);
  }

  .sidebar-cta p {
