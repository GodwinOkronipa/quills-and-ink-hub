        </div>

        <div class="dash-controls">
          <div class="live-status-pill">
            <span class="live-dot"></span>
            <span>Live Stream Active</span>
          </div>

          <div class="time-range-group" role="group" aria-label="Select analytics timeframe">
            <button type="button" class="time-btn" data-time="24h">24H</button>
            <button type="button" class="time-btn" data-time="7d">7D</button>
            <button type="button" class="time-btn is-active" data-time="30d">30D</button>
