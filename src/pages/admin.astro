<script is:inline>
  (() => {
    // -------------------------------------------------------------------------
    // Client-side Encrypted Authentication & Session Gate
    // -------------------------------------------------------------------------
    const SALT = 'quills_salt_2026';
    const EXPECTED_HASH = '70993b407894d65b3817ffa0bf03f0868f8335fcff8fd85e1dcc24a9102f569c';
    const SESSION_KEY = 'quills_admin_auth_token';

    const loginView = document.getElementById('admin-login-view');
    const dashboardView = document.getElementById('admin-dashboard-view');
    const loginForm = document.getElementById('admin-login-form');
    const passkeyInput = document.getElementById('admin-passkey');
    const errorMsg = document.getElementById('login-error-msg');
    const autofillBtn = document.getElementById('btn-autofill-demo');
    const toggleEyeBtn = document.getElementById('toggle-passkey-visibility');
    const logoutBtn = document.getElementById('btn-admin-logout');

    // SHA-256 calculation via Web Crypto API
    async function sha256(text) {
      const encoder = new TextEncoder();
      const data = encoder.encode(text);
      const hashBuffer = await crypto.subtle.digest('SHA-256', data);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map((b) => b.toString(16).padStart(2, '0')).join('');
    }

    // Check existing session
    function checkSession() {
      const session = sessionStorage.getItem(SESSION_KEY);
      if (session) {
        try {
          const parsed = JSON.parse(session);
          if (parsed && parsed.authenticated && parsed.expiresAt > Date.now()) {
            showDashboard();
            return true;
          }
        } catch (e) {
          sessionStorage.removeItem(SESSION_KEY);
        }
      }
      showLogin();
      return false;
    }

    function showDashboard() {
      if (loginView) loginView.style.display = 'none';
      if (dashboardView) {
        dashboardView.style.display = 'block';
        dashboardView.scrollIntoView({ behavior: 'smooth' });
      }
    }

    function showLogin() {
      if (loginView) loginView.style.display = 'flex';
      if (dashboardView) dashboardView.style.display = 'none';
    }

    // Autofill demo button
    autofillBtn?.addEventListener('click', () => {
      if (passkeyInput) {
        passkeyInput.value = 'quills-admin-2026';
        passkeyInput.focus();
      }
    });

    // Toggle visibility
    toggleEyeBtn?.addEventListener('click', () => {
      if (!passkeyInput) return;
      const isPass = passkeyInput.getAttribute('type') === 'password';
      passkeyInput.setAttribute('type', isPass ? 'text' : 'password');
      toggleEyeBtn.textContent = isPass ? '🙈' : '👁️';
    });

    // Form submission
    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const enteredPasskey = passkeyInput.value.trim();
      if (!enteredPasskey) return;

      errorMsg.style.display = 'none';

      // 1. Client-Side Hash Verification
      const computedHash = await sha256(`${SALT}:${enteredPasskey}`);

      // Check match or demo fallback
      if (computedHash === EXPECTED_HASH || enteredPasskey === 'quills-admin-2026') {
        const sessionPayload = {
          authenticated: true,
          token: crypto.randomUUID ? crypto.randomUUID() : 'session_' + Date.now(),
          expiresAt: Date.now() + 1000 * 60 * 60 * 8, // 8 hour session
        };
        sessionStorage.setItem(SESSION_KEY, JSON.stringify(sessionPayload));
        showDashboard();
      } else {
        errorMsg.textContent = 'Invalid passkey. Please check the demo credential above.';
        errorMsg.style.display = 'block';
      }
    });

    // Logout
    logoutBtn?.addEventListener('click', () => {
      sessionStorage.removeItem(SESSION_KEY);
      showLogin();
    });

    // -------------------------------------------------------------------------
    // Dashboard Tabs Navigation
    // -------------------------------------------------------------------------
    const tabs = document.querySelectorAll('.dash-tab');
    const panels = {
      analytics: document.getElementById('panel-analytics'),
      content: document.getElementById('panel-content'),
      diaspora: document.getElementById('panel-diaspora'),
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');

        const target = tab.getAttribute('data-dash-tab');
        Object.keys(panels).forEach((key) => {
          if (panels[key]) {
            panels[key].style.display = key === target ? 'block' : 'none';
          }
        });
      });
    });

    // -------------------------------------------------------------------------
    // Live Event Stream Integration
    // -------------------------------------------------------------------------
    const eventsContainer = document.getElementById('live-events-container');

    function appendLiveEvent(type, headline, meta, badgeClass) {
      if (!eventsContainer) return;
      const item = document.createElement('div');
      item.className = 'event-item event-item--fresh';
      item.innerHTML = `
        <div class="event-badge ${badgeClass}">${type}</div>
        <div class="event-details">
          <div class="event-headline">${headline}</div>
          <div class="event-meta">${meta}</div>
        </div>
        <div class="event-time">Just now</div>
      `;
      eventsContainer.insertBefore(item, eventsContainer.firstChild);

      // Keep max 15 events
      while (eventsContainer.children.length > 15) {
        eventsContainer.removeChild(eventsContainer.lastChild);
      }
    }

    // Listen to real application analytics events
    window.addEventListener('quills:analytics', (e) => {
      const detail = e.detail || {};
      if (detail.event === 'file_download') {
        appendLiveEvent(
          'DOWNLOAD',
          detail.file_name || 'Memorial Resource Download',
          `URL: ${detail.file_url} · Attribution: ${detail.attribution || 'Quills & Ink'}`,
          'badge-dl'
        );
      } else if (detail.event === 'site_search_query') {
        appendLiveEvent(
          'SEARCH',
          `Query: "${detail.query}"`,
          `Live user search input from site modal`,
          'badge-search'
        );
      } else if (detail.event === 'whatsapp_chat_click') {
        appendLiveEvent(
          'WHATSAPP',
          'Direct WhatsApp chat initiation',
          `Origin: ${detail.page || 'Website'}`,
          'badge-wa'
        );
      } else {
        appendLiveEvent(
          'EVENT',
          detail.event,
          `Path: ${detail.path || window.location.pathname}`,
          'badge-book'
        );
      }
    });

    // Test simulation buttons
    document.getElementById('btn-test-download-event')?.addEventListener('click', () => {
      if (window.quillsAnalytics) {
        window.quillsAnalytics.track('file_download', {
          file_name: 'The Art of Remembrance: Eulogy Guide (PDF)',
          file_url: '/downloads/eulogy-writing-guide.pdf',
          attribution: 'Quills & Ink Editorial Archive',
        });
      }
    });

    document.getElementById('btn-test-search-event')?.addEventListener('click', () => {
      if (window.quillsAnalytics) {
        window.quillsAnalytics.track('site_search_query', {
          query: 'diaspora family synthesis',
        });
      }
    });

    // Check session on page load
    checkSession();
  })();
</script>

