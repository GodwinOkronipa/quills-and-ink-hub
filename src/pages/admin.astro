    border-bottom: 1px solid var(--color-line);
  }

  .gate-logo {
    font-size: 2.75rem;
    color: var(--color-charcoal);
    display: block;
    line-height: 1;
  }

  .gate-tag {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-peach-deep);
