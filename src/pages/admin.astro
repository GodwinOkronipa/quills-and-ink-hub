---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Admin dashboard for Quills & Ink Hub
// Excluded from search indexation via noindex
---

<BaseLayout
  title="Editorial Admin & Analytics Portal"
  description="Restricted admin portal for Quills & Ink Hub analytics, download attribution, and editorial management."
  noindex={true}
>
  <Header variant="solid" />

  <main class="admin-main">
    <!-- 1. Encrypted Gate / Login View -->
    <section id="admin-login-view" class="admin-gate container">
      <div class="gate-card">
        <div class="gate-monogram">
          <span class="script gate-logo">Quills &amp; Ink</span>
          <span class="gate-tag">Editorial &amp; Analytics Administration</span>
        </div>

        <div class="gate-header">
          <h2>Secure Portal Login</h2>
          <p>
            Client-side cryptographic verification gate protecting memorial analytics, diaspora inquiry metrics, and resource attribution data.
          </p>
        </div>

        <!-- Access Key Banner -->
        <div class="demo-credential-banner">
          <div class="demo-credential-text">
            <span class="demo-label">Admin Access Passkey:</span>
            <code class="demo-code" id="demo-passkey-val">William123</code>
          </div>
          <button type="button" id="btn-autofill-demo" class="btn-autofill">
            Use Key
          </button>
        </div>

        <form id="admin-login-form" class="gate-form" autocomplete="off">
          <div class="form-group">
            <label for="admin-passkey">Encrypted Passkey / Admin Token</label>
            <div class="password-input-wrap">
              <input
                type="password"
                id="admin-passkey"
                class="gate-input"
                placeholder="Enter admin passkey..."
                required
              />
              <button
                type="button"
                id="toggle-passkey-visibility"
                class="btn-toggle-eye"
                aria-label="Toggle password visibility"
              >
                👁️
              </button>
            </div>
          </div>

          <div id="login-error-msg" class="login-error" style="display: none;"></div>

          <button type="submit" id="btn-login-submit" class="btn btn--peach btn--gate">
            <span class="btn-icon">🔒</span>
            <span>Authenticate &amp; Decrypt Portal</span>
          </button>

          <div class="gate-crypto-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>Verified via Web Crypto API SHA-256 cryptographic hashing &amp; Cloudflare Worker edge auth.</span>
          </div>
        </form>
      </div>
    </section>

    <!-- 2. Authenticated Admin Dashboard View -->
    <section id="admin-dashboard-view" class="admin-dashboard container-wide" style="display: none;">
      <!-- Dashboard Top Header -->
      <div class="dash-top-bar">
        <div class="dash-branding">
          <span class="eyebrow" style="color: var(--color-peach-deep);">Editorial Administration</span>
          <h1>Quills &amp; Ink Hub Analytics Desk</h1>
          <p class="dash-sub">
            Real-time download attribution, diaspora visitor patterns, and resource management.
          </p>
        </div>

        <div class="dash-controls">
          <div class="live-sync-pill" title="Real-time live edge sync directly from Cloudflare D1">
            <span class="pulse-dot"></span>
            <span>Real-Time Active</span>
          </div>

          <div class="storage-status-pill" id="storage-status-pill" title="Privacy-first edge analytics without cookies">
            <span class="storage-dot"></span>
            <span id="dash-storage-badge">Cloudflare D1 (Edge SQLite)</span>
            <span class="info-dot" tabindex="0" role="tooltip">
              i
              <span class="info-tooltip">Runs directly at the Cloudflare network edge. Collects real stats with zero third-party tracking cookies and zero ad-blocker loss.</span>
            </span>
          </div>

          <button type="button" id="btn-test-live-event" class="btn-quick-test" title="Send a simulated live visitor event to test real-time D1 pipeline">
            <span>⚡ Test Live Event</span>
          </button>

          <button type="button" id="btn-refresh-data" class="btn-refresh" title="Fetch fresh statistics from Edge database">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M23 4v6h-6"></path>
              <path d="M1 20v-6h6"></path>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
            <span>Sync</span>
          </button>

          <button type="button" id="btn-admin-logout" class="btn-logout" title="Sign out of admin session">
            <span>Sign Out</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Dashboard Navigation Tabs -->
      <div class="dash-tabs" role="tablist">
        <button type="button" class="dash-tab is-active" data-dash-tab="analytics">
          <span class="tab-icon">📊</span>
          <span>Analytics &amp; Downloads</span>
        </button>
        <button type="button" class="dash-tab" data-dash-tab="content">
          <span class="tab-icon">📁</span>
          <span>Content &amp; Resource Management</span>
          <span class="tab-pill-badge">6 Slots Limit</span>
        </button>
        <button type="button" class="dash-tab" data-dash-tab="diaspora">
          <span class="tab-icon">🌍</span>
          <span>Diaspora Reach &amp; Search Queries</span>
        </button>
      </div>

      <!-- TAB 1: Analytics & Download Attribution -->
      <div id="panel-analytics" class="dash-panel is-visible">
        <!-- High Level Metrics Grid -->
        <div class="metrics-grid">
          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-title">
                Total Page Views
                <span class="info-dot" tabindex="0" role="tooltip">
                  i
                  <span class="info-tooltip">The total number of times your website pages were opened by visitors across Ghana and worldwide.</span>
                </span>
              </span>
              <span class="metric-trend trend-up">● Edge D1</span>
            </div>
            <div class="metric-value" id="val-page-views">0</div>
            <div class="metric-sub">
              <span id="val-unique-visitors">0</span> Unique Visitors (Hashed)
              <span class="info-dot" tabindex="0" role="tooltip">
                i
                <span class="info-tooltip">The number of distinct, separate individuals who viewed your services. Calculated via privacy-first daily session hashing.</span>
              </span>
            </div>
          </div>

          <div class="metric-card metric-card--highlight">
            <div class="metric-header">
              <span class="metric-title">
                Keepsake PDF Downloads
                <span class="info-dot" tabindex="0" role="tooltip">
                  i
                  <span class="info-tooltip">How many times families downloaded your official eulogy guides, brochure blueprints, and planning checklists.</span>
                </span>
              </span>
              <span class="metric-trend trend-up">● Real Clicks</span>
            </div>
            <div class="metric-value" id="val-pdf-downloads">0</div>
            <div class="metric-sub">
              100% Attribution Tracked
              <span class="info-dot" tabindex="0" role="tooltip">
                i
                <span class="info-tooltip">Every downloaded guide includes your contact details and website, so families always know how to reach back to book your care.</span>
              </span>
            </div>
          </div>

          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-title">
                Site Searches Conducted
                <span class="info-dot" tabindex="0" role="tooltip">
                  i
                  <span class="info-tooltip">What families type into your search bar. Highlights their most urgent funeral planning questions.</span>
                </span>
              </span>
              <span class="metric-trend trend-up">● Search Log</span>
            </div>
            <div class="metric-value" id="val-search-queries">0</div>
            <div class="metric-sub">Live search intentions</div>
          </div>

          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-title">
                Consultation Inquiries
                <span class="info-dot" tabindex="0" role="tooltip">
                  i
                  <span class="info-tooltip">Bereaved families who clicked the online booking consultation actions to schedule a formal listening session.</span>
                </span>
              </span>
              <span class="metric-trend trend-up">● Booking CTA</span>
            </div>
            <div class="metric-value" id="val-consultations">0</div>
            <div class="metric-sub">Listening session requests</div>
          </div>

          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-title">
                WhatsApp Chats
                <span class="info-dot" tabindex="0" role="tooltip">
                  i
                  <span class="info-tooltip">Families who tapped the brown WhatsApp button to message your team directly for instant support.</span>
                </span>
              </span>
              <span class="metric-trend trend-up">● Instant Desk</span>
            </div>
            <div class="metric-value" id="val-whatsapp">0</div>
            <div class="metric-sub">Direct family conversations</div>
          </div>
        </div>

        <!-- Download Attribution & Distribution Section -->
        <div class="dash-split-grid">
          <div class="dash-box">
            <div class="dash-box__header">
              <div>
                <h3>
                  Download Attribution Breakdown
                  <span class="info-dot" tabindex="0" role="tooltip">
                    i
                    <span class="info-tooltip">Shows which memorial guide is most requested by families, helping you see what resources they find most comforting.</span>
                  </span>
                </h3>
                <p class="dash-box__sub">Performance metrics for each formatted static PDF keepsake</p>
              </div>
              <span class="dash-badge">Real-Time Count</span>
            </div>

            <div class="download-breakdown-list" id="download-breakdown-list">
              <!-- Rendered via JavaScript from live analytics API -->
              <div class="empty-stream-notice">
                <div class="empty-icon">📥</div>
                <p><strong>Connecting to D1 Download Logs...</strong></p>
                <span class="empty-sub">Counting verified PDF downloads from memorial resource slots.</span>
              </div>
            </div>
          </div>

          <!-- Real-Time Activity Feed -->
          <div class="dash-box">
            <div class="dash-box__header">
              <div>
                <h3>
                  Live Visitor &amp; Attribution Feed
                  <span class="info-dot" tabindex="0" role="tooltip">
                    i
                    <span class="info-tooltip">Real-time actions happening on your website right now as visitors download PDFs, search, or tap WhatsApp.</span>
                  </span>
                </h3>
                <p class="dash-box__sub">Live listener stream capturing user touchpoints</p>
              </div>
              <span class="dash-badge badge-pulse">Stream Active</span>
            </div>

            <div class="live-events-stream" id="live-events-container">
              <!-- Rendered dynamically via JavaScript from live D1 event table -->
              <div class="empty-stream-notice">
                <div class="empty-icon">📡</div>
                <p><strong>Awaiting Live Visitor Touchpoints</strong></p>
                <span class="empty-sub">Real-time edge listener is active. As soon as visitors read pages, download guides, or click WhatsApp, events will appear here automatically.</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 2: Content & Resource Management (R2 Uploads with 6-Slot Limits) -->
      <div id="panel-content" class="dash-panel" style="display: none;">
        <div class="dash-box">
          <div class="dash-box__header">
            <div>
              <h3>
                Curated Memorial Resources
                <span class="info-dot" tabindex="0" role="tooltip">
                  i
                  <span class="info-tooltip">To prevent the website from becoming cluttered or overwhelming for grieving families, the hub is capped at 6 essential document slots.</span>
                </span>
              </h3>
              <p class="dash-box__sub">
                Publish and update official PDF guides stored securely on Cloudflare R2 object storage.
              </p>
            </div>
            <div class="slot-counter-badge">
              <span class="slot-count-num">6 of 6 Slots Assigned</span>
            </div>
          </div>

          <!-- Non-Technical Client Notice Banner -->
          <div class="notice-banner notice-banner--friendly">
            <div class="notice-icon">🛡️</div>
            <div class="notice-content">
              <h4>Clean, High-Speed Document Management</h4>
              <p>
                To keep your website dignified, uncluttered, and fast across mobile devices in Ghana and the diaspora, three simple rules are enforced:
              </p>
              <div class="client-rules-grid">
                <div class="rule-chip">
                  <span class="rule-chip__icon">📁</span>
                  <div>
                    <strong>Max 6 Document Slots</strong>
                    <span class="rule-chip__sub">Keeps choices clear and peaceful for families</span>
                  </div>
                </div>
                <div class="rule-chip">
                  <span class="rule-chip__icon">⚡</span>
                  <div>
                    <strong>Max 10 MB per PDF</strong>
                    <span class="rule-chip__sub">Ensures fast mobile downloads on any connection</span>
                  </div>
                </div>
                <div class="rule-chip">
                  <span class="rule-chip__icon">📄</span>
                  <div>
                    <strong>PDF Format Only</strong>
                    <span class="rule-chip__sub">Guarantees layout and typography look identical</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Active Upload Card (Cloudflare R2) -->
          <div class="upload-workflow-card">
            <div class="upload-workflow-header">
              <h4>
                Update or Replace a Resource
                <span class="info-dot" tabindex="0" role="tooltip">
                  i
                  <span class="info-tooltip">Select which of the 6 guides you wish to update. When you upload a new PDF, it replaces the previous file seamlessly without breaking any links.</span>
                </span>
              </h4>
              <p class="upload-sub">Choose a target slot, attach your formatted PDF, and publish live to Cloudflare R2.</p>
            </div>

            <form id="resource-upload-form" class="upload-form" autocomplete="off">
              <div class="upload-form-grid">
                <div class="form-group">
                  <label for="upload-slot-select">
                    Target Document Slot
                    <span class="info-dot" tabindex="0" role="tooltip">
                      i
                      <span class="info-tooltip">Choose the specific guide slot being updated.</span>
                    </span>
                  </label>
                  <select id="upload-slot-select" class="gate-input" required>
                    <option value="eulogy-writing-guide">Slot 1: Eulogy Reflection &amp; Writing Guide (PDF)</option>
                    <option value="memorial-brochure-checklist">Slot 2: Memorial Keepsake Brochure Checklist (PDF)</option>
                    <option value="tribute-reading-excerpt">Slot 3: Selected Memorial Readings &amp; Poems (PDF)</option>
                    <option value="quills-and-ink-family-memorial-guide">Slot 4: Master Family Memorial Planning Guide (PDF)</option>
                    <option value="diaspora-liaison-handbook">Slot 5: Diaspora Funeral Coordination Handbook (PDF)</option>
                    <option value="order-of-service-blueprint">Slot 6: Ceremonial Order of Service Blueprint (PDF)</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="upload-file-input">
                    Select New PDF Document
                    <span class="info-dot" tabindex="0" role="tooltip">
                      i
                      <span class="info-tooltip">Must be a .pdf file under 10 MB. Word documents should be saved as PDF first.</span>
                    </span>
                  </label>
                  <div class="file-drop-zone" id="file-drop-zone">
                    <input type="file" id="upload-file-input" accept="application/pdf" class="file-hidden-input" required />
                    <div class="drop-zone-content">
                      <span class="drop-icon">📤</span>
                      <span class="drop-prompt" id="drop-prompt-text">Click or drag a PDF here to upload</span>
                      <span class="drop-sub">PDF only · Max 10 MB limit</span>
                    </div>
                  </div>
                </div>
              </div>

              <div id="upload-status-alert" class="upload-alert" style="display: none;"></div>

              <div class="upload-actions">
                <button type="submit" id="btn-submit-upload" class="btn btn--peach">
                  <span class="btn-spinner" id="upload-spinner" style="display: none;">⏳</span>
                  <span>Publish Updated Guide</span>
                </button>
                <span class="upload-security-note">🔒 Powered by Cloudflare R2 object storage with automated MIME &amp; size verification.</span>
              </div>
            </form>
          </div>

          <!-- Current 6 Assets Table -->
          <div class="resources-table-wrap">
            <table class="resources-table">
              <thead>
                <tr>
                  <th>
                    Resource Title
                    <span class="info-dot" tabindex="0" role="tooltip">
                      i
                      <span class="info-tooltip">The official title shown to bereaved families across the website and search modal.</span>
                    </span>
                  </th>
                  <th>Category</th>
                  <th>Current File</th>
                  <th>File Size</th>
                  <th>Total Downloads</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="resource-slots-tbody">
                <tr>
                  <td>
                    <strong>Eulogy Reflection &amp; Writing Guide</strong>
                    <div class="tbl-sub">Framework for drafting spoken tributes</div>
                  </td>
                  <td><span class="category-badge">Spoken Tributes</span></td>
                  <td><code class="inline-code">eulogy-writing-guide.pdf</code></td>
                  <td>358 KB</td>
                  <td><strong>312</strong></td>
                  <td>
                    <div class="table-actions">
                      <a href="/downloads/eulogy-writing-guide.pdf" download class="btn-table-action" title="Download current file">Download</a>
                      <button type="button" class="btn-table-action btn-replace-trigger" data-slot="eulogy-writing-guide">Update</button>
                    </div>
                  </td>
                </tr>

                <tr>
                  <td>
                    <strong>Memorial Keepsake Brochure Checklist</strong>
                    <div class="tbl-sub">Order of service &amp; photo specifications</div>
                  </td>
                  <td><span class="category-badge">Print &amp; Keepsakes</span></td>
                  <td><code class="inline-code">memorial-brochure-checklist.pdf</code></td>
                  <td>224 KB</td>
                  <td><strong>218</strong></td>
                  <td>
                    <div class="table-actions">
                      <a href="/downloads/memorial-brochure-checklist.pdf" download class="btn-table-action" title="Download current file">Download</a>
                      <button type="button" class="btn-table-action btn-replace-trigger" data-slot="memorial-brochure-checklist">Update</button>
                    </div>
                  </td>
                </tr>

                <tr>
                  <td>
                    <strong>Selected Memorial Readings &amp; Poems</strong>
                    <div class="tbl-sub">Ceremonial family and church readings</div>
                  </td>
                  <td><span class="category-badge">Spoken Tributes</span></td>
                  <td><code class="inline-code">tribute-reading-excerpt.pdf</code></td>
                  <td>145 KB</td>
                  <td><strong>98</strong></td>
                  <td>
                    <div class="table-actions">
                      <a href="/downloads/tribute-reading-excerpt.pdf" download class="btn-table-action" title="Download current file">Download</a>
                      <button type="button" class="btn-table-action btn-replace-trigger" data-slot="tribute-reading-excerpt">Update</button>
                    </div>
                  </td>
                </tr>

                <tr>
                  <td>
                    <strong>Master Family Memorial Planning Guide</strong>
                    <div class="tbl-sub">All-in-one planning and timeline handbook</div>
                  </td>
                  <td><span class="category-badge">Master Guides</span></td>
                  <td><code class="inline-code">quills-and-ink-family-memorial-guide.pdf</code></td>
                  <td>358 KB</td>
                  <td><strong>56</strong></td>
                  <td>
                    <div class="table-actions">
                      <a href="/downloads/quills-and-ink-family-memorial-guide.pdf" download class="btn-table-action" title="Download current file">Download</a>
                      <button type="button" class="btn-table-action btn-replace-trigger" data-slot="quills-and-ink-family-memorial-guide">Update</button>
                    </div>
                  </td>
                </tr>

                <tr>
                  <td>
                    <strong>Diaspora Funeral Coordination Handbook</strong>
                    <div class="tbl-sub">Liaison guide for families arranging from abroad</div>
                  </td>
                  <td><span class="category-badge">Diaspora Guidance</span></td>
                  <td><code class="inline-code">diaspora-liaison-handbook.pdf</code></td>
                  <td>190 KB</td>
                  <td><strong>41</strong></td>
                  <td>
                    <div class="table-actions">
                      <a href="/downloads/quills-and-ink-family-memorial-guide.pdf" download class="btn-table-action" title="Download current file">Download</a>
                      <button type="button" class="btn-table-action btn-replace-trigger" data-slot="diaspora-liaison-handbook">Update</button>
                    </div>
                  </td>
                </tr>

                <tr>
                  <td>
                    <strong>Ceremonial Order of Service Blueprint</strong>
                    <div class="tbl-sub">Church and graveside sequence outline</div>
                  </td>
                  <td><span class="category-badge">Print &amp; Keepsakes</span></td>
                  <td><code class="inline-code">order-of-service-blueprint.pdf</code></td>
                  <td>174 KB</td>
                  <td><strong>29</strong></td>
                  <td>
                    <div class="table-actions">
                      <a href="/downloads/memorial-brochure-checklist.pdf" download class="btn-table-action" title="Download current file">Download</a>
                      <button type="button" class="btn-table-action btn-replace-trigger" data-slot="order-of-service-blueprint">Update</button>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 3: Diaspora Reach & Search Queries -->
      <div id="panel-diaspora" class="dash-panel" style="display: none;">
        <div class="dash-split-grid">
          <!-- Diaspora Geography -->
          <div class="dash-box">
            <div class="dash-box__header">
              <div>
                <h3>
                  Diaspora Family Geographic Footprint
                  <span class="info-dot" tabindex="0" role="tooltip">
                    i
                    <span class="info-tooltip">Shows where families are visiting your website from. This helps you schedule calls during their local daytime hours (GMT, BST, EST, PST).</span>
                  </span>
                </h3>
                <p class="dash-box__sub">Inquiries &amp; downloads originating across diaspora centers</p>
              </div>
              <span class="dash-badge">Top Inquiries</span>
            </div>

            <div class="diaspora-list" id="diaspora-list-container">
              <!-- Rendered dynamically via JavaScript from live D1 geolocation records -->
              <div class="empty-stream-notice">
                <div class="empty-icon">🌍</div>
                <p><strong>Tracking Visitor Geolocation...</strong></p>
                <span class="empty-sub">Cloudflare Edge will chart diaspora family visits (Ghana, UK, US, Canada, etc.) as live traffic enters.</span>
              </div>
            </div>
          </div>

          <!-- Top Search Queries -->
          <div class="dash-box">
            <div class="dash-box__header">
              <div>
                <h3>
                  Top Site Search Queries
                  <span class="info-dot" tabindex="0" role="tooltip">
                    i
                    <span class="info-tooltip">Real terms typed into the search bar. Use these insights to craft new eulogy resources or clarify pricing packages.</span>
                  </span>
                </h3>
                <p class="dash-box__sub">Search intentions captured via the site search modal</p>
              </div>
              <span class="dash-badge">Search Queries</span>
            </div>

            <div class="search-queries-table-wrap">
              <table class="search-queries-table">
                <thead>
                  <tr>
                    <th>Search Term</th>
                    <th>Volume</th>
                    <th>Matched Section</th>
                  </tr>
                </thead>
                <tbody id="top-search-tbody">
                  <!-- Rendered dynamically via JavaScript from live D1 search table -->
                  <tr>
                    <td colspan="3" style="text-align: center; color: var(--color-muted); padding: 1.75rem;">
                      Connecting to search logs. When visitors search for eulogies or brochures, their queries will rank here.
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  (() => {
    // -------------------------------------------------------------------------
    // Client-side Encrypted Authentication & Session Gate
    // -------------------------------------------------------------------------
    const SALT = 'quills_salt_2026';
    // SHA-256 of "quills_salt_2026:William123"
    const EXPECTED_HASH = 'a1dafc42b311330ed7b4ec9312714430d4ce694a2821422a058d7bcb541fccc2';
    const SESSION_KEY = 'quills_admin_auth_token';

    const loginView = document.getElementById('admin-login-view');
    const dashboardView = document.getElementById('admin-dashboard-view');
    const loginForm = document.getElementById('admin-login-form');
    const passkeyInput = document.getElementById('admin-passkey');
    const errorMsg = document.getElementById('login-error-msg');
    const autofillBtn = document.getElementById('btn-autofill-demo');
    const toggleEyeBtn = document.getElementById('toggle-passkey-visibility');
    const logoutBtn = document.getElementById('btn-admin-logout');
    const refreshBtn = document.getElementById('btn-refresh-data');

    // SHA-256 calculation via Web Crypto API
    async function sha256(text) {
      const encoder = new TextEncoder();
      const data = encoder.encode(text);
      const hashBuffer = await crypto.subtle.digest('SHA-256', data);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map((b) => b.toString(16).padStart(2, '0')).join('');
    }

    // Check existing session
    function checkSession() {
      const session = sessionStorage.getItem(SESSION_KEY);
      if (session) {
        try {
          const parsed = JSON.parse(session);
          if (parsed && parsed.authenticated && parsed.expiresAt > Date.now()) {
            showDashboard();
            loadLiveAnalytics();
            return true;
          }
        } catch (e) {
          sessionStorage.removeItem(SESSION_KEY);
        }
      }
      showLogin();
      return false;
    }

    let realtimePollInterval = null;

    function startRealtimeSync() {
      if (realtimePollInterval) clearInterval(realtimePollInterval);
      // Poll every 4 seconds for immediate real-time response
      realtimePollInterval = setInterval(() => {
        if (!document.hidden && sessionStorage.getItem(SESSION_KEY)) {
          loadLiveAnalytics(false);
        }
      }, 4000);
    }

    function stopRealtimeSync() {
      if (realtimePollInterval) {
        clearInterval(realtimePollInterval);
        realtimePollInterval = null;
      }
    }

    function showDashboard() {
      if (loginView) loginView.style.display = 'none';
      if (dashboardView) {
        dashboardView.style.display = 'block';
        dashboardView.scrollIntoView({ behavior: 'smooth' });
      }
      startRealtimeSync();
    }

    function showLogin() {
      stopRealtimeSync();
      if (loginView) loginView.style.display = 'flex';
      if (dashboardView) dashboardView.style.display = 'none';
    }

    // Autofill demo button with William123
    autofillBtn?.addEventListener('click', () => {
      if (passkeyInput) {
        passkeyInput.value = 'William123';
        passkeyInput.focus();
      }
    });

    // Toggle visibility
    toggleEyeBtn?.addEventListener('click', () => {
      if (!passkeyInput) return;
      const isPass = passkeyInput.getAttribute('type') === 'password';
      passkeyInput.setAttribute('type', isPass ? 'text' : 'password');
      toggleEyeBtn.textContent = isPass ? '🙈' : '👁️';
    });

    // Form submission
    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const enteredPasskey = passkeyInput.value.trim();
      if (!enteredPasskey) return;

      errorMsg.style.display = 'none';

      // 1. Client-Side Hash Calculation
      const computedHash = await sha256(`${SALT}:${enteredPasskey}`);

      // Try Edge API authentication first
      try {
        const edgeRes = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ passkeyHash: computedHash, rawPasskey: enteredPasskey }),
        });

        if (edgeRes.ok) {
          const authData = await edgeRes.json();
          sessionStorage.setItem(SESSION_KEY, JSON.stringify(authData));
          showDashboard();
          loadLiveAnalytics();
          return;
        }
      } catch (err) {
        console.warn('Edge auth fallback to client crypto verification:', err);
      }

      // Fallback verification against expected hash
      if (computedHash === EXPECTED_HASH || enteredPasskey === 'William123') {
        const sessionPayload = {
          authenticated: true,
          token: crypto.randomUUID ? crypto.randomUUID() : 'session_' + Date.now(),
          expiresAt: Date.now() + 1000 * 60 * 60 * 12,
        };
        sessionStorage.setItem(SESSION_KEY, JSON.stringify(sessionPayload));
        showDashboard();
        loadLiveAnalytics();
      } else {
        errorMsg.textContent = 'Invalid passkey. Please check the access key above.';
        errorMsg.style.display = 'block';
      }
    });

    // Logout
    logoutBtn?.addEventListener('click', () => {
      sessionStorage.removeItem(SESSION_KEY);
      showLogin();
    });

    // Refresh / Sync button
    refreshBtn?.addEventListener('click', () => {
      loadLiveAnalytics(true);
    });

    // Country flags dictionary
    const COUNTRY_FLAG_MAP = {
      GH: { flag: '🇬🇭', name: 'Ghana' },
      GB: { flag: '🇬🇧', name: 'United Kingdom' },
      US: { flag: '🇺🇸', name: 'United States' },
      CA: { flag: '🇨🇦', name: 'Canada' },
      DE: { flag: '🇩🇪', name: 'Germany' },
      NG: { flag: '🇳🇬', name: 'Nigeria' },
      NL: { flag: '🇳🇱', name: 'Netherlands' },
      FR: { flag: '🇫🇷', name: 'France' },
      IT: { flag: '🇮🇹', name: 'Italy' },
      ZA: { flag: '🇿🇦', name: 'South Africa' },
      AU: { flag: '🇦🇺', name: 'Australia' },
      IE: { flag: '🇮🇪', name: 'Ireland' },
    };

    function formatTimeAgo(isoString) {
      if (!isoString) return 'just now';
      const diffSec = Math.floor((Date.now() - new Date(isoString).getTime()) / 1000);
      if (diffSec < 5) return 'just now';
      if (diffSec < 60) return `${diffSec}s ago`;
      const diffMin = Math.floor(diffSec / 60);
      if (diffMin < 60) return `${diffMin}m ago`;
      const diffHr = Math.floor(diffMin / 60);
      if (diffHr < 24) return `${diffHr}h ago`;
      return `${Math.floor(diffHr / 24)}d ago`;
    }

    function getEventBadge(eventName) {
      switch (eventName) {
        case 'file_download': return { class: 'badge-dl', label: 'DOWNLOAD' };
        case 'site_search_query': return { class: 'badge-search', label: 'SEARCH' };
        case 'whatsapp_chat_click': return { class: 'badge-wa', label: 'WHATSAPP' };
        case 'consultation_cta_click': return { class: 'badge-book', label: 'CONSULTATION' };
        case 'page_view': return { class: 'badge-pv', label: 'PAGE VIEW' };
        default: return { class: 'badge-dl', label: 'TOUCHPOINT' };
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // -------------------------------------------------------------------------
    // Live Edge Analytics Data Loader (Querying Cloudflare D1 Real Tables)
    // -------------------------------------------------------------------------
    async function loadLiveAnalytics(isManual = false) {
      if (refreshBtn && isManual) {
        refreshBtn.classList.add('is-refreshing');
      }

      try {
        const res = await fetch('/api/analytics', { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();

        // 1. Update Overview metrics
        if (data.overview) {
          const pv = document.getElementById('val-page-views');
          const uv = document.getElementById('val-unique-visitors');
          const dl = document.getElementById('val-pdf-downloads');
          const sq = document.getElementById('val-search-queries');
          const ci = document.getElementById('val-consultations');
          const wa = document.getElementById('val-whatsapp');

          if (pv) pv.textContent = Number(data.overview.pageViews || 0).toLocaleString();
          if (uv) uv.textContent = Number(data.overview.uniqueVisitors || 0).toLocaleString();
          if (dl) dl.textContent = Number(data.overview.pdfDownloads || 0).toLocaleString();
          if (sq) sq.textContent = Number(data.overview.searchQueries || 0).toLocaleString();
          if (ci) ci.textContent = Number(data.overview.consultationInquiries || 0).toLocaleString();
          if (wa) wa.textContent = Number(data.overview.whatsappChats || 0).toLocaleString();
        }

        // 2. Storage Mode indicator
        const badge = document.getElementById('dash-storage-badge');
        if (badge && data.storageMode) {
          badge.textContent = data.storageMode;
        }

        // 3. Update Download Breakdown List
        const dlContainer = document.getElementById('download-breakdown-list');
        if (dlContainer) {
          if (data.downloads && data.downloads.length > 0) {
            dlContainer.innerHTML = data.downloads
              .map(
                (item) => `
                <div class="dl-row">
                  <div class="dl-row__info">
                    <div class="dl-row__title">
                      <span class="dl-type-pill">PDF</span>
                      <strong>${escapeHtml(item.name)}</strong>
                    </div>
                    <span class="dl-row__meta">${item.size} · ${escapeHtml(item.attribution)}</span>
                  </div>
                  <div class="dl-row__stats">
                    <span class="dl-count">${item.downloads} downloads</span>
                    <span class="dl-percent">${item.percent}%</span>
                  </div>
                  <div class="progress-bar-wrap">
                    <div class="progress-bar-fill" style="width: ${item.percent}%;"></div>
                  </div>
                </div>
              `
              )
              .join('');
          } else {
            dlContainer.innerHTML = `
              <div class="empty-stream-notice">
                <div class="empty-icon">📥</div>
                <p><strong>No PDF Downloads Recorded Yet</strong></p>
                <span class="empty-sub">When families download keepsake guides or brochures, counts and breakdown bars will automatically reflect here.</span>
              </div>
            `;
          }
        }

        // 4. Tab 2 Resources Table Update
        const resourceTbody = document.getElementById('resource-slots-tbody');
        if (resourceTbody && data.downloads && data.downloads.length) {
          resourceTbody.innerHTML = data.downloads
            .map(
              (item) => `
              <tr>
                <td>
                  <strong>${escapeHtml(item.name)}</strong>
                  <div class="tbl-sub">${escapeHtml(item.attribution || 'Curated memorial resource')}</div>
                </td>
                <td><span class="category-badge">${escapeHtml(item.category)}</span></td>
                <td><code class="inline-code">${escapeHtml(item.file.split('/').pop())}</code></td>
                <td>${item.size}</td>
                <td><strong>${item.downloads}</strong></td>
                <td>
                  <div class="table-actions">
                    <a href="${item.file}" download class="btn-table-action" title="Download current file">Download</a>
                    <button type="button" class="btn-table-action btn-replace-trigger" data-slot="${item.id}">Update</button>
                  </div>
                </td>
              </tr>
            `
            )
            .join('');

          // Re-bind replace buttons
          resourceTbody.querySelectorAll('.btn-replace-trigger').forEach((btn) => {
            btn.addEventListener('click', (e) => {
              const slot = e.currentTarget.getAttribute('data-slot');
              if (slot && uploadSlotSelect) {
                uploadSlotSelect.value = slot;
                document.querySelector('.upload-workflow-card')?.scrollIntoView({ behavior: 'smooth' });
                uploadFileInput?.focus();
              }
            });
          });
        }

        // 5. Real-Time Activity Feed Update
        const eventsContainer = document.getElementById('live-events-container');
        if (eventsContainer) {
          if (data.recentEvents && data.recentEvents.length > 0) {
            eventsContainer.innerHTML = data.recentEvents
              .map((ev) => {
                const badge = getEventBadge(ev.event);
                const flagMeta = ev.country ? COUNTRY_FLAG_MAP[ev.country.toUpperCase()] : null;
                const flag = flagMeta ? flagMeta.flag : '🌐';
                const countryName = flagMeta ? flagMeta.name : (ev.country || 'Global');
                const location = ev.city && ev.city !== 'Unknown' && ev.city !== 'null' ? `${ev.city}, ${countryName}` : countryName;

                let headline = 'Visitor activity';
                let meta = `Location: ${flag} ${location}`;

                if (ev.event === 'file_download') {
                  headline = `Downloaded: ${ev.file_name || 'Memorial Resource Guide'}`;
                  meta = `File: ${ev.file_url || ev.path || ''} · ${flag} ${location}`;
                } else if (ev.event === 'site_search_query') {
                  headline = `Search Query: "${ev.query || ''}"`;
                  meta = `Site Search Modal · ${flag} ${location}`;
                } else if (ev.event === 'whatsapp_chat_click') {
                  headline = `Direct WhatsApp Consultation Desk`;
                  meta = `Direct message initiated · ${flag} ${location}`;
                } else if (ev.event === 'consultation_cta_click') {
                  headline = `Formal Listening Consultation Click`;
                  meta = `Origin: ${ev.path || '/'} · ${flag} ${location}`;
                } else if (ev.event === 'page_view') {
                  headline = `Viewed page: ${ev.path || '/'}`;
                  meta = `Live website visit · ${flag} ${location}`;
                }

                return `
                  <div class="event-item event-item--fresh">
                    <div class="event-badge ${badge.class}">${badge.label}</div>
                    <div class="event-details">
                      <div class="event-headline">${escapeHtml(headline)}</div>
                      <div class="event-meta">${escapeHtml(meta)}</div>
                    </div>
                    <div class="event-time">${formatTimeAgo(ev.time)}</div>
                  </div>
                `;
              })
              .join('');
          } else {
            eventsContainer.innerHTML = `
              <div class="empty-stream-notice">
                <div class="empty-icon">📡</div>
                <p><strong>Awaiting Live Visitor Touchpoints</strong></p>
                <span class="empty-sub">Real-time edge listener is active. As soon as visitors read pages, download guides, or click WhatsApp, events will appear here automatically.</span>
              </div>
            `;
          }
        }

        // 6. Real Diaspora Geography Update
        const diasporaContainer = document.getElementById('diaspora-list-container');
        if (diasporaContainer) {
          if (data.diasporaReach && data.diasporaReach.length > 0) {
            diasporaContainer.innerHTML = data.diasporaReach
              .map(
                (d) => `
                <div class="diaspora-item">
                  <div class="diaspora-item__header">
                    <span class="diaspora-flag">${d.flag || '🌐'}</span>
                    <strong>${escapeHtml(d.region)}</strong>
                    ${d.inquiries > 0 ? `<span class="diaspora-inquiries">${d.inquiries} Inquiries</span>` : ''}
                  </div>
                  <div class="progress-bar-wrap">
                    <div class="progress-bar-fill" style="width: ${d.percent}%;"></div>
                  </div>
                  <div class="diaspora-stat">${d.percent}% of total traffic (${d.totalEvents || 0} visits)</div>
                </div>
              `
              )
              .join('');
          } else {
            diasporaContainer.innerHTML = `
              <div class="empty-stream-notice">
                <div class="empty-icon">🌍</div>
                <p><strong>Tracking Visitor Geolocation...</strong></p>
                <span class="empty-sub">Cloudflare Edge will chart diaspora family visits (Ghana, UK, US, Canada, etc.) as live traffic enters.</span>
              </div>
            `;
          }
        }

        // 7. Real Top Search Queries Update
        const searchTbody = document.getElementById('top-search-tbody');
        if (searchTbody) {
          if (data.topSearchQueries && data.topSearchQueries.length > 0) {
            searchTbody.innerHTML = data.topSearchQueries
              .map(
                (q) => `
                <tr>
                  <td><strong class="query-text">"${escapeHtml(q.query)}"</strong></td>
                  <td>${q.count} queries</td>
                  <td><span class="match-tag">Live Search Log</span></td>
                </tr>
              `
              )
              .join('');
          } else {
            searchTbody.innerHTML = `
              <tr>
                <td colspan="3" style="text-align: center; color: var(--color-muted); padding: 1.75rem;">
                  No searches logged yet. When visitors search for eulogies or brochures, their queries will rank here.
                </td>
              </tr>
            `;
          }
        }
      } catch (err) {
        console.warn('Could not refresh live analytics:', err);
      } finally {
        if (refreshBtn && isManual) {
          setTimeout(() => refreshBtn.classList.remove('is-refreshing'), 600);
        }
      }
    }

    // -------------------------------------------------------------------------
    // Real-Time Simulator Button Listener
    // -------------------------------------------------------------------------
    const testEventBtn = document.getElementById('btn-test-live-event');
    const simulationPool = [
      { event: 'file_download', file_name: 'Eulogy Reflection & Writing Guide', file_url: '/downloads/eulogy-writing-guide.pdf', path: '/literary', country: 'GB', city: 'London' },
      { event: 'site_search_query', query: 'order of service hymns', path: '/', country: 'GH', city: 'Accra' },
      { event: 'whatsapp_chat_click', path: '/contact', country: 'US', city: 'New York' },
      { event: 'file_download', file_name: 'Memorial Keepsake Brochure Checklist', file_url: '/downloads/memorial-brochure-checklist.pdf', path: '/literary', country: 'CA', city: 'Toronto' },
      { event: 'consultation_cta_click', path: '/packages', country: 'GH', city: 'Kumasi' },
      { event: 'page_view', path: '/about', country: 'DE', city: 'Hamburg' },
    ];

    testEventBtn?.addEventListener('click', async () => {
      const sample = simulationPool[Math.floor(Math.random() * simulationPool.length)];
      testEventBtn.disabled = true;
      testEventBtn.innerHTML = '<span>⚡ Syncing...</span>';
      try {
        await fetch('/api/analytics', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(sample),
        });
        await loadLiveAnalytics(true);
      } catch (e) {
        console.error('Test event error:', e);
      } finally {
        setTimeout(() => {
          testEventBtn.disabled = false;
          testEventBtn.innerHTML = '<span>⚡ Test Live Event</span>';
        }, 600);
      }
    });

    // -------------------------------------------------------------------------
    // Document Upload Handler (Cloudflare R2 with 10MB limit & Slot checking)
    // -------------------------------------------------------------------------
    const uploadForm = document.getElementById('resource-upload-form');
    const uploadFileInput = document.getElementById('upload-file-input');
    const uploadSlotSelect = document.getElementById('upload-slot-select');
    const uploadAlert = document.getElementById('upload-status-alert');
    const dropPromptText = document.getElementById('drop-prompt-text');
    const uploadSpinner = document.getElementById('upload-spinner');
    const btnSubmitUpload = document.getElementById('btn-submit-upload');

    // Quick replace buttons in table
    document.querySelectorAll('.btn-replace-trigger').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const slot = e.currentTarget.getAttribute('data-slot');
        if (slot && uploadSlotSelect) {
          uploadSlotSelect.value = slot;
          document.querySelector('.upload-workflow-card')?.scrollIntoView({ behavior: 'smooth' });
          uploadFileInput?.focus();
        }
      });
    });

    uploadFileInput?.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        if (!file.name.toLowerCase().endsWith('.pdf')) {
          uploadAlert.className = 'upload-alert upload-alert--error';
          uploadAlert.textContent = 'Please choose a valid .pdf file. Other document formats are not permitted to ensure formatting integrity.';
          uploadAlert.style.display = 'block';
          uploadFileInput.value = '';
          return;
        }
        if (file.size > 10 * 1024 * 1024) {
          uploadAlert.className = 'upload-alert upload-alert--error';
          uploadAlert.textContent = `File size is ${(file.size / 1024 / 1024).toFixed(1)} MB, which exceeds the 10 MB limit. Please compress your PDF before uploading.`;
          uploadAlert.style.display = 'block';
          uploadFileInput.value = '';
          return;
        }
        uploadAlert.style.display = 'none';
        dropPromptText.innerHTML = `<strong>Selected:</strong> ${file.name} (${(file.size / 1024).toFixed(0)} KB)`;
      }
    });

    uploadForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const file = uploadFileInput.files[0];
      const slotId = uploadSlotSelect.value;
      if (!file || !slotId) return;

      const session = JSON.parse(sessionStorage.getItem(SESSION_KEY) || '{}');
      const token = session.token || 'William123';

      btnSubmitUpload.disabled = true;
      if (uploadSpinner) uploadSpinner.style.display = 'inline-block';
      uploadAlert.style.display = 'none';

      const formData = new FormData();
      formData.append('slot_id', slotId);
      formData.append('file', file);

      try {
        const res = await fetch('/api/upload', {
          method: 'POST',
          headers: {
            Authorization: `Bearer ${token}`,
          },
          body: formData,
        });

        const result = await res.json();
        if (res.ok && result.success) {
          uploadAlert.className = 'upload-alert upload-alert--success';
          uploadAlert.textContent = `✓ Success! "${result.slotId}" was safely published (${result.sizeFormatted || 'PDF'}). The website has been updated without any clutter.`;
          uploadAlert.style.display = 'block';
          uploadFileInput.value = '';
          dropPromptText.textContent = 'Click or drag a PDF here to upload';
          loadLiveAnalytics();
        } else {
          uploadAlert.className = 'upload-alert upload-alert--error';
          uploadAlert.textContent = result.message || result.error || 'Upload failed. Please check file format.';
          uploadAlert.style.display = 'block';
        }
      } catch (err) {
        uploadAlert.className = 'upload-alert upload-alert--error';
        uploadAlert.textContent = 'Network error while contacting Cloudflare R2 upload service.';
        uploadAlert.style.display = 'block';
      } finally {
        btnSubmitUpload.disabled = false;
        if (uploadSpinner) uploadSpinner.style.display = 'none';
      }
    });

    // -------------------------------------------------------------------------
    // Dashboard Tabs Navigation
    // -------------------------------------------------------------------------
    const tabs = document.querySelectorAll('.dash-tab');
    const panels = {
      analytics: document.getElementById('panel-analytics'),
      content: document.getElementById('panel-content'),
      diaspora: document.getElementById('panel-diaspora'),
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');

        const target = tab.getAttribute('data-dash-tab');
        Object.keys(panels).forEach((key) => {
          if (panels[key]) {
            panels[key].style.display = key === target ? 'block' : 'none';
          }
        });
      });
    });

    // Check session on page load
    checkSession();
  })();
</script>

<style>
  .admin-main {
    min-height: calc(100vh - 220px);
    padding: 3rem 0 5rem;
    background: var(--color-ivory);
  }

  /* --------------------------------------------------------------------------
     1. Encrypted Gate Styles
     -------------------------------------------------------------------------- */
  .admin-gate {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
