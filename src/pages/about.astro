---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const portfolioSlides = [
  {
    title: 'Garden Memorial · East Legon, Accra',
    category: 'Gatherings',
    tag: 'Full Event Coordination',
    image: 'https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=1200&q=80',
    alt: 'Outdoor garden memorial gathering in East Legon with ivory florals and white canopy drapery',
  },
  {
    title: 'Diaspora-Supported Service · Cantonments',
    category: 'Gatherings',
    tag: 'Hybrid Coordination',
    image: 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&w=1200&q=80',
    alt: 'Diaspora family memorial coordination and live stream ceremony',
  },
  {
    title: 'Quiet Chapel Farewell · Ridge Church, Accra',
    category: 'Gatherings',
    tag: 'Church Memorial',
    image: 'https://images.unsplash.com/photo-1478146896981-b80fe463b330?auto=format&fit=crop&w=1200&q=80',
    alt: 'Solemn chapel farewell service with intimate seating layout at Ridge Church',
  },
  {
    title: 'Floral Sanctuary & Memorial Wreaths',
    category: 'Décor & Floral',
    tag: 'Floral Design',
    image: 'https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&w=1200&q=80',
    alt: 'Curated white roses and memorial floral wreaths in soft natural light',
  },
  {
    title: '36-Page Memorial Keepsake Brochure',
    category: 'Brochures & Print',
    tag: 'Stationery & Print',
    image: 'https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1200&q=80',
    alt: 'Editorial memorial tribute brochure keepsake with foil stamped detailing',
  },
  {
    title: 'Evening Vigil & Candlelight Reception',
    category: 'Décor & Floral',
    tag: 'Evening Gathering',
    image: 'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80',
    alt: 'Warm candlelight reception and evening vigil with floral arches',
  },
];
---

<BaseLayout
  title="About Us"
  description="Learn how Quills and Ink Hub supports Ghanaian families with dignified funeral planning and literary care."
>
  <Header variant="transparent" />
  <main>
    <PageHero
      script="Our story"
      title="Care that listens before it plans"
      subtitle="We exist to make farewell gatherings orderly, culturally resonant, and gently held — for families in Ghana and across the diaspora."
      image="https://images.unsplash.com/photo-1518199266791-5375a83190b7?auto=format&fit=crop&w=1800&q=70"
    />

    <section class="about container">
      <div class="about__copy">
        <h2 class="section-title">A steady presence in tender seasons</h2>
        <p>
          Quills and Ink Hub brings together funeral event coordination and literary
          craft. Families often need both at once: someone to organise logistics,
          and someone to find the right words.
        </p>
        <p>
          Our approach is calm and clear. We honour Ghanaian traditions while making
          space for modern family realities — including relatives joining from abroad.
        </p>
        <p>
          From the quiet intimacy of chapel farewells to large family celebrations of life,
          every detail is guided with reverence, punctuality, and artistic sensitivity.
        </p>
        <div class="about__actions">
          <a class="btn btn--peach" href="/portfolio">Explore Our Portfolio</a>
          <a class="btn btn--brown" href="/contact">WhatsApp Consultation</a>
        </div>
      </div>

      <!-- Portfolio Image Carousel -->
      <div class="about__media">
        <div
          class="about-carousel"
          data-about-carousel
          aria-roledescription="carousel"
          aria-label="Quills and Ink Hub Portfolio Highlights"
        >
          <div class="about-carousel__viewport">
            <div class="about-carousel__track" data-carousel-track>
              {
                portfolioSlides.map((item, index) => (
                  <div
                    class={`about-carousel__slide ${index === 0 ? 'is-active' : ''}`}
                    data-slide-index={index}
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`${index + 1} of ${portfolioSlides.length}: ${item.title}`}
                  >
                    <img
                      src={item.image}
                      alt={item.alt}
                      width="1000"
                      height="1250"
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                    <div class="about-carousel__overlay">
                      <span class="about-carousel__tag">{item.tag}</span>
                      <h3 class="about-carousel__title">{item.title}</h3>
                    </div>
                  </div>
                ))
              }
            </div>

            <!-- Controls overlay -->
            <button
              type="button"
              class="carousel-nav carousel-nav--prev"
              data-carousel-prev
              aria-label="Previous portfolio highlight"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button
              type="button"
              class="carousel-nav carousel-nav--next"
              data-carousel-next
              aria-label="Next portfolio highlight"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>

            <!-- Bottom pagination dots & counter -->
            <div class="about-carousel__footer">
              <div class="carousel-dots" data-carousel-dots aria-label="Slide indicators">
                {
                  portfolioSlides.map((_, idx) => (
                    <button
                      type="button"
                      class={`carousel-dot ${idx === 0 ? 'is-active' : ''}`}
                      data-dot-index={idx}
                      aria-label={`Jump to slide ${idx + 1}`}
                    />
                  ))
                }
              </div>
              <span class="carousel-counter" data-carousel-counter>
                <strong data-current-num>01</strong> / 0{portfolioSlides.length}
              </span>
            </div>
          </div>
        </div>

        <!-- Direct Button Link to Portfolio -->
        <div class="about__portfolio-cta">
          <a class="btn btn--outline btn--portfolio-link" href="/portfolio">
            <span>View Full Portfolio</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  (() => {
    const carousel = document.querySelector('[data-about-carousel]');
    if (!carousel) return;

    const track = carousel.querySelector('[data-carousel-track]');
    const slides = carousel.querySelectorAll('.about-carousel__slide');
    const dots = carousel.querySelectorAll('.carousel-dot');
    const prevBtn = carousel.querySelector('[data-carousel-prev]');
    const nextBtn = carousel.querySelector('[data-carousel-next]');
    const currentNum = carousel.querySelector('[data-current-num]');

    let currentIndex = 0;
    const totalSlides = slides.length;
    let autoPlayTimer = null;

    function goToSlide(index) {
      if (index < 0) {
        currentIndex = totalSlides - 1;
      } else if (index >= totalSlides) {
        currentIndex = 0;
      } else {
        currentIndex = index;
      }

      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.add('is-active');
        } else {
          slide.classList.remove('is-active');
        }
      });

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.add('is-active');
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.classList.remove('is-active');
          dot.removeAttribute('aria-current');
        }
      });

      if (currentNum) {
        currentNum.textContent = String(currentIndex + 1).padStart(2, '0');
      }
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 4500);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        goToSlide(currentIndex - 1);
        startAutoPlay();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        goToSlide(currentIndex + 1);
        startAutoPlay();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const targetIdx = parseInt(e.currentTarget.getAttribute('data-dot-index'), 10);
        if (!isNaN(targetIdx)) {
          goToSlide(targetIdx);
          startAutoPlay();
        }
      });
    });

    // Touch swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    carousel.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoPlay();
    }, { passive: true });

    carousel.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
      startAutoPlay();
    }, { passive: true });

    function handleSwipe() {
      const swipeDistance = touchEndX - touchStartX;
      if (Math.abs(swipeDistance) > 40) {
        if (swipeDistance < 0) {
          goToSlide(currentIndex + 1);
        } else {
          goToSlide(currentIndex - 1);
        }
      }
    }

    // Pause on hover
    carousel.addEventListener('mouseenter', stopAutoPlay);
    carousel.addEventListener('mouseleave', startAutoPlay);

    // Initial launch
    startAutoPlay();
  })();
</script>

<style>
  .about {
    display: grid;
    gap: 2.5rem;
    padding: 4.5rem 0 5.5rem;
  }

  .about__copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  p {
    font-family: var(--font-serif);
    font-size: 1.12rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  /* Carousel Media Column */
  .about__media {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-carousel {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(44, 36, 22, 0.12);
    background: var(--color-wood);
  }

  .about-carousel__viewport {
    position: relative;
    width: 100%;
    min-height: 24rem;
    aspect-ratio: 4 / 4.8;
    overflow: hidden;
  }

  .about-carousel__track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .about-carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    transform: scale(1.03);
    z-index: 1;
  }

  .about-carousel__slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    z-index: 2;
  }

  .about-carousel__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-carousel__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.25rem 1.75rem 4rem;
    background: linear-gradient(
      to top,
      rgba(26, 22, 18, 0.88) 0%,
      rgba(26, 22, 18, 0.45) 35%,
      rgba(26, 22, 18, 0) 70%
    );
    color: #ffffff;
    pointer-events: none;
  }

  .about-carousel__tag {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-peach, #c9a892);
    margin-bottom: 0.35rem;
  }

  .about-carousel__title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.3;
  }

  /* Navigation Arrows */
  .carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(26, 22, 18, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .carousel-nav:hover {
    background: rgba(26, 22, 18, 0.9);
    border-color: var(--color-peach);
    transform: translateY(-50%) scale(1.08);
  }

  .carousel-nav--prev {
    left: 1rem;
  }

  .carousel-nav--next {
    right: 1rem;
  }

  /* Footer: Dots & Counter */
  .about-carousel__footer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.5rem;
    background: rgba(20, 17, 14, 0.65);
    backdrop-filter: blur(6px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .carousel-dots {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .carousel-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.3s var(--ease), transform 0.3s var(--ease), width 0.3s var(--ease);
  }

  .carousel-dot.is-active {
    background: var(--color-peach, #c9a892);
    width: 1.25rem;
    border-radius: 999px;
  }

  .carousel-counter {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.75);
  }

  .carousel-counter strong {
    color: var(--color-peach, #c9a892);
  }

  /* Portfolio CTA Button */
  .about__portfolio-cta {
    display: flex;
  }

  .btn--portfolio-link {
    width: 100%;
    justify-content: center;
    border-color: var(--color-wood-mid, #5c4a38);
    background: #ffffff;
    color: var(--color-wood, #3d3226);
    box-shadow: 0 4px 12px rgba(44, 36, 22, 0.05);
  }

  .btn--portfolio-link:hover {
    background: var(--color-wood, #3d3226);
    color: #ffffff;
    border-color: var(--color-wood, #3d3226);
  }

  @media (min-width: 880px) {
    .about {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 4rem;
    }
  }
</style>
