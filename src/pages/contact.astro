---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contact"
  description="Contact Quills and Ink Hub — inquiry form, telephone desk, WhatsApp assistance, and Accra office details."
>
  <Header />
  <main>
    <PageHero
      script="Hello"
      title="We are here when you need us"
      subtitle="Send a quiet inquiry, call our desk, or reach us on WhatsApp. We respond promptly across local and international time zones."
      image="https://images.unsplash.com/photo-1423666639041-f56000c27a9a?auto=format&fit=crop&w=1800&q=70"
    />

    <section class="contact container">
      <div class="contact__main">
        <form class="contact__form" data-contact-form novalidate>
          <div class="field">
            <label for="c-name">Your Full Name</label>
            <input id="c-name" name="name" type="text" placeholder="e.g. Ama Serwaa" required autocomplete="name" />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="c-email">Email Address</label>
              <input id="c-email" name="email" type="email" placeholder="ama@example.com" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="c-phone">Phone / WhatsApp</label>
              <input id="c-phone" name="phone" type="tel" placeholder="+233 53 995 5615" required autocomplete="tel" />
            </div>
          </div>
          <div class="field">
            <label for="c-subject">Subject</label>
            <input id="c-subject" name="subject" type="text" placeholder="e.g. Planning support for upcoming memorial in Accra" required />
          </div>
          <div class="field">
            <label for="c-message">How may we support you?</label>
            <textarea
              id="c-message"
              name="message"
              rows="5"
              placeholder="Tell us about your timeline, expected attendees, or whether you need literary support..."
              required
            ></textarea>
          </div>
          <p class="contact__status" data-contact-status role="status" aria-live="polite"></p>
          <button class="btn btn--ink" type="submit">Send Message</button>
        </form>

        <div class="contact__success is-hidden" data-contact-success>
          <span class="success-icon" aria-hidden="true">✉️</span>
          <h2>Thank you for reaching out.</h2>
          <p>
            Your inquiry has been received. Our team will review your message and reply via email or WhatsApp within a few hours.
          </p>
          <a
            class="btn btn--peach"
            href="https://wa.me/233539955615?text=Hello%20Quills%20and%20Ink%20Hub,%20I%20just%20sent%20an%20inquiry%20via%20your%20website."
            target="_blank"
            rel="noopener noreferrer"
          >
            Continue to WhatsApp
          </a>
        </div>
      </div>

      <aside class="contact__details">
        <div class="contact-card">
          <p class="eyebrow">WhatsApp (Immediate Assistance)</p>
          <a
            class="contact-link contact-link--highlight"
            href="https://wa.me/233539955615?text=Hello%20Quills%20and%20Ink%20Hub,%20I%20am%20reaching%20out%20for%20information%20on%20your%20funeral%20services."
            target="_blank"
            rel="noopener noreferrer"
          >
            +233 53 995 5615
          </a>
          <p class="muted">Active messaging for both Ghana &amp; overseas families.</p>
        </div>

        <div class="contact-card">
          <p class="eyebrow">Direct Telephone</p>
          <a class="contact-link" href="tel:+233539955615">+233 53 995 5615</a>
          <p class="muted">Office line open Monday – Saturday, 8:00 AM – 7:00 PM GMT.</p>
        </div>

        <div class="contact-card">
          <p class="eyebrow">Direct Email</p>
          <a class="contact-link" href="mailto:hello@quillsandinkhub.com">hello@quillsandinkhub.com</a>
          <p class="muted">For inquiries, proposals, and memorial manuscripts.</p>
        </div>

        <div class="contact-card">
          <p class="eyebrow">Connect &amp; Follow</p>
          <div class="contact-socials">
            <a
              href="https://wa.me/233539955615"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-social-item"
              title="WhatsApp"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.46 0 .09 5.37.09 11.97c0 2.11.55 4.16 1.6 5.97L0 24l6.23-1.63a11.94 11.94 0 0 0 5.83 1.51h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.21-3.52-8.43zM12.07 21.88h-.01c-1.79 0-3.55-.48-5.08-1.39l-.36-.22-3.77.99 1.01-3.68-.24-.38a9.92 9.92 0 0 1-1.52-5.23c0-5.48 4.47-9.95 9.97-9.95 2.66 0 5.16 1.04 7.04 2.92 1.88 1.88 2.92 4.38 2.92 7.04 0 5.49-4.47 9.9-9.95 9.9zm5.46-7.46c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.49-.9-.8-1.5-1.79-1.67-2.09-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.21 3.07c.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.72.23 1.37.2 1.89.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35z"></path>
              </svg>
              <span>WhatsApp Support Desk</span>
            </a>
            <a
              href="https://www.instagram.com/quillsninkhub"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-social-item"
              title="Instagram"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>Instagram (@quillsninkhub)</span>
            </a>
            <a
              href="https://youtube.com/@quillsninkhub?si=31S-2wMesX_K7Okd"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-social-item"
              title="YouTube"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
              </svg>
              <span>YouTube Channel</span>
            </a>
            <a
              href="https://vm.tiktok.com/ZS9UgBPr6rhmW-BqT8Y/"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-social-item"
              title="TikTok"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.48 6.27 6.27 0 0 0 1.86-4.47V8.71a8.19 8.19 0 0 0 4.91 1.63V6.89a4.85 4.85 0 0 1-1-.2z"></path>
              </svg>
              <span>TikTok (@quillsninkhub)</span>
            </a>
          </div>
        </div>

        <div class="contact-card">
          <p class="eyebrow">Accra Office Location</p>
          <p class="contact-address">
            Suite 4B, Heritage House<br />
            Liberation Road, Airport Residential Area<br />
            Accra, Ghana
          </p>
          <p class="muted">In-person consultations by prior appointment.</p>
        </div>
      </aside>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: 2.5rem;
    padding: 4rem 0 5.5rem;
  }

  .contact__form,
  .contact__success {
    display: grid;
    gap: 1.15rem;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    padding: 2.25rem 1.75rem;
  }

  .contact__success {
    gap: 1.25rem;
    animation: fade-in 0.4s var(--ease);
  }

  .contact__success.is-hidden {
    display: none;
  }

  .success-icon {
    font-size: 2.25rem;
  }

  .contact__success h2 {
    font-size: 1.85rem;
    color: var(--color-charcoal);
  }

  .contact__success p {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-wood-mid);
    line-height: 1.7;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field-row {
    display: grid;
    gap: 1.15rem;
  }

  label {
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 500;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid var(--color-line);
    background: var(--color-ivory);
    padding: 0.85rem 0.95rem;
    color: var(--color-ink);
    border-radius: 0;
    transition: border-color 0.2s var(--ease);
  }

  input:focus,
  textarea:focus {
    outline: 2px solid color-mix(in srgb, var(--color-peach) 55%, transparent);
    outline-offset: 1px;
    border-color: var(--color-peach);
  }

  .btn {
    justify-self: start;
  }

  .contact__status {
    min-height: 1.4em;
    font-family: var(--font-serif);
    color: #a8422b;
    font-size: 0.95rem;
  }

  .contact__details {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .contact-card {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    padding: 1.75rem 1.5rem;
    display: grid;
    gap: 0.35rem;
  }

  .contact-link {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-charcoal);
    transition: color 0.2s var(--ease);
  }

  .contact-link:hover {
    color: var(--color-peach-deep);
  }

  .contact-link--highlight {
    color: var(--color-peach-deep);
    font-weight: 600;
  }

  .contact-address {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-charcoal);
  }

  .muted {
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 0.95rem;
    margin-top: 0.2rem;
  }

  .contact-socials {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .contact-social-item {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.92rem;
    color: var(--color-charcoal);
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .contact-social-item:hover {
    color: var(--color-peach-deep);
    transform: translateX(3px);
  }

  .contact-social-item svg {
    flex-shrink: 0;
    color: var(--color-peach-deep);
  }

  @media (min-width: 720px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 1.25fr 0.75fr;
      align-items: start;
    }
  }
</style>

<script>
  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const successBox = document.querySelector<HTMLElement>('[data-contact-success]');
  const statusElem = document.querySelector<HTMLElement>('[data-contact-status]');

  contactForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!contactForm) return;

    if (!contactForm.checkValidity()) {
      contactForm.reportValidity();
      if (statusElem) statusElem.textContent = 'Please fill out all required fields.';
      return;
    }

    contactForm.style.display = 'none';
    if (successBox) {
      successBox.classList.remove('is-hidden');
      successBox.style.display = 'grid';
    }
  });
</script>

