      outline-offset: 4px;
      box-shadow: 0 0 0 8px rgba(201, 168, 146, 0.3), 0 10px 24px rgba(184, 92, 24, 0.15);
      background-color: #fffbf7;
    }
    100% {
      outline: 1px solid transparent;
      outline-offset: 0;
      box-shadow: none;
      background-color: transparent;
    }
  }

  .target-highlight-glow {
    animation: targetPulseGlow 3.8s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
    border-color: var(--color-peach-deep) !important;
    position: relative;
    z-index: 10;
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab-target]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel-id]');

  function activateTab(targetId: string) {
    tabs.forEach((t) => {
      const isTarget = t.dataset.tabTarget === targetId;
      t.classList.toggle('is-active', isTarget);
      t.setAttribute('aria-selected', isTarget ? 'true' : 'false');
    });

    panels.forEach((p) => {
      if (p.dataset.panelId === targetId) {
        p.classList.remove('is-hidden');
      } else {
        p.classList.add('is-hidden');
      }
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tabTarget;
      if (target) activateTab(target);
    });
  });

  function triggerLiteraryHighlight(hash: string) {
    if (!hash) return;
    const cleanId = hash.replace(/^#/, '');

    // If target is one of the sample panels or tabs (e.g. panel-eulogy, panel-tribute, panel-brochure)
    if (cleanId.startsWith('panel-') || cleanId.startsWith('tab-')) {
      const tabTarget = cleanId.replace(/^(panel|tab)-/, '');
      activateTab(tabTarget);
    }

    const targetEl = document.getElementById(cleanId);
    if (targetEl) {
      targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      targetEl.classList.remove('target-highlight-glow');
      void targetEl.offsetWidth; // Force CSS reflow
      targetEl.classList.add('target-highlight-glow');

      setTimeout(() => {
        targetEl.classList.remove('target-highlight-glow');
      }, 3900);
    }
  }

  // Expose globally for SearchModal or same-page interactions
  (window as any).triggerLiteraryHighlight = triggerLiteraryHighlight;

  // On page load with hash
  window.addEventListener('load', () => {
    if (window.location.hash) {
      setTimeout(() => {
        triggerLiteraryHighlight(window.location.hash);
      }, 200);
    }
  });

  // On hash change
  window.addEventListener('hashchange', () => {
    if (window.location.hash) {
      triggerLiteraryHighlight(window.location.hash);
    }
  });
</script>
