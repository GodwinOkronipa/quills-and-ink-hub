  /* Keyframes for focus & glow pulse */
  @keyframes targetPulseGlow {
    0% {
      outline: 3px solid rgba(184, 92, 24, 0.9);
      outline-offset: 4px;
      box-shadow: 0 0 0 8px rgba(201, 168, 146, 0.45), 0 12px 32px rgba(184, 92, 24, 0.25);
      background-color: #fff9f2;
    }
    30% {
