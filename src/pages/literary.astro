---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const services = [
  {
    title: 'Eulogies',
    tag: 'Spoken Remembrance',
    text: 'A narrative shaped from intimate family conversations — respectful, heartfelt, and true to the deceased’s life values, faith, and ancestry.',
  },
  {
    title: 'Family & Group Tributes',
    tag: 'Personal Voices',
    text: 'Individual or collective readings crafted for children, siblings, friends, church fellowships, or professional associations.',
  },
  {
    title: 'Memorial Brochures & Programs',
    tag: 'Keepsake Print',
    text: 'Complete order of service text, biography composition, hymns selection, photo captions, and acknowledgments tailored for printing in Ghana or abroad.',
  },
  {
    title: 'Diaspora Family Synthesis',
    tag: 'Remote Coordination',
    text: 'Gathering written reflections and voice notes from loved ones across multiple countries and blending them into a harmonious, polished family keepsake.',
  },
];

const samples = [
  {
    id: 'tribute',
    title: 'Memorial Tribute',
    context: 'Spoken on behalf of the family',
    content: [
      'In quiet rooms and crowded courtyards alike, we remember a life that made space for others.',
      'Not by grand speeches alone, but by the ordinary kindnesses that became our family’s compass — the open door at dusk, the unhurried counsel, the steady reassurance when storms gathered.',
      'Today we gather not to finish this story, but to place it reverently in our collective keeping — so that love may continue to speak in the warm language of home.',
    ],
    file: '/downloads/tribute-reading-excerpt.pdf',
    txtFile: '/samples/tribute-excerpt.txt',
    downloadLabel: 'Download Tribute Keepsake (PDF)',
    fileSize: '145 KB',
    attribution: 'Quills & Ink Hub Ceremonial Spoken Archive',
    image: 'https://images.unsplash.com/photo-1499209974431-9dddcece7f88?auto=format&fit=crop&w=800&q=80',
    alt: 'Tranquil dawn light reflection for ceremonial tribute',
    imageCaption: 'Ceremonial Archive · Dawn Reflection',
  },
  {
    id: 'eulogy',
    title: 'Eulogy Excerpt · Life & Legacy',
    context: 'Read during the church celebration of life',
    content: [
      'To speak of Papa is to speak of patience forged in faith and quiet perseverance. Born in the rolling hills of the Eastern Region, he understood early that true nobility is not in what one gathers, but in what one pours out.',
      'Through decades of devotion to his family, his church, and the young minds he mentored, he wore integrity like a familiar cloth. His laughter could disarm a room; his silence carried wisdom that outlasted hours of debate.',
      'We stand here today as trees planted by his rivers of sacrifice. Though his physical voice is still, the soil of our lives remains forever enriched by his living.',
    ],
    file: '/downloads/eulogy-writing-guide.pdf',
    txtFile: '/samples/eulogy-writing-guide.txt',
    downloadLabel: 'Download Eulogy Guide (PDF)',
    fileSize: '358 KB',
    attribution: 'Quills & Ink Hub Editorial Archive · Ghanaian Remembrance Series',
    image: 'https://images.unsplash.com/photo-1457369804613-52c61a468e7d?auto=format&fit=crop&w=800&q=80',
    alt: 'Open study journal and pen for family eulogy writing',
    imageCaption: 'Literary Study & Eulogy Framework',
  },
  {
    id: 'brochure',
    title: 'Memorial Brochure Dedication',
    context: 'Frontispiece and order of service introduction',
    content: [
      '“A life well lived is a quiet hymn that echoes across generations.”',
      'This memorial brochure is compiled with heartfelt gratitude by the family across Accra, London, Washington, and Toronto. As you hold these pages, may the memories within comfort your spirit and remind you of the grace that walked among us.',
    ],
    file: '/downloads/memorial-brochure-checklist.pdf',
    txtFile: '/samples/memorial-brochure-checklist.txt',
    downloadLabel: 'Download Brochure Checklist (PDF)',
    fileSize: '224 KB',
    attribution: 'Quills & Ink Hub Print & Editorial Division',
    image: 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=800&q=80',
    alt: 'Printed memorial keepsake book and layout',
    imageCaption: 'Memorial Keepsake Print Archive',
  },
];
---

<BaseLayout
  title="Literary Services & Downloadable Keepsake Guides"
  description="Professional eulogies, tributes, memorial brochures, and diaspora family writing services. Download beautifully formatted PDF reflection guides and checklists."
>
  <Header />
  <main>
    <PageHero
      script="Words"
      title="Literary services that honour a life"
      subtitle="When families need language for love and loss, we write with restraint, cultural dignity, and gentle care."
      image="https://images.unsplash.com/photo-1457369804613-52c61a468e7d?auto=format&fit=crop&w=1800&q=70"
    />

    <section class="literary container">
      <div class="literary__services">
        <div class="literary__heading">
          <p class="eyebrow">Our Literary Offerings</p>
          <h2>Crafted with dignity, patience, and cultural resonance</h2>
        </div>
        <div class="services-list">
          {
            services.map((s) => (
              <article class="service-item">
                <span class="service-item__tag">{s.tag}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div class="literary__samples">
        <!-- YouTube View Box: Memorial & Eulogy Inspiration -->
        <div class="video-card">
          <div class="video-card__header">
            <p class="eyebrow">The Spoken Word · Literary Inspiration</p>
            <h3>When Words Speak What the Heart Cannot Carry Alone</h3>
            <p class="video-card__desc">
              Watch a timeless testament to the power of a heartfelt eulogy — W. H. Auden’s <em>Funeral Blues</em>. Words chosen with honesty, cadence, and quiet devotion carry love across generations.
            </p>
          </div>

          <div class="video-card__player">
            <iframe
              src="https://www.youtube-nocookie.com/embed/bPgkl2dPqGw?start=8&rel=0"
              title="Memorial Tribute Reading · Funeral Blues"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>

          <div class="video-card__caption">
            <p class="script video-card__quote">“Stop all the clocks, cut off the telephone...”</p>
            <p class="video-card__note">
              Every life holds poetry waiting to be spoken. Whether preparing a eulogy, sibling tribute, or memorial brochure, we collaborate with your family to find words that ring true.
            </p>
          </div>
        </div>

        <div class="samples-card">
          <p class="eyebrow">Reading Samples &amp; Templates</p>
          <h2>Sample excerpts from our literary archives</h2>

          <div class="samples-tabs" role="tablist" aria-label="Sample excerpts">
            {samples.map((s, idx) => (
              <button
                type="button"
                role="tab"
                class:list={['sample-tab', idx === 0 && 'is-active']}
                data-tab-target={s.id}
                aria-selected={idx === 0 ? 'true' : 'false'}
                aria-controls={`panel-${s.id}`}
                id={`tab-${s.id}`}
              >
                {s.title}
              </button>
            ))}
          </div>

          <div class="samples-panels">
            {samples.map((s, idx) => (
              <div
                id={`panel-${s.id}`}
                role="tabpanel"
                aria-labelledby={`tab-${s.id}`}
                class:list={['sample-panel', idx !== 0 && 'is-hidden']}
                data-panel-id={s.id}
              >
                <div class="sample-split-grid">
                  <div class="sample-content-side">
                    <p class="sample-context">{s.context}</p>
                    <blockquote>
                      {s.content.map((p) => (
                        <p>{p}</p>
                      ))}
                    </blockquote>
                    <div class="sample-actions">
                      <a
                        class="btn btn--outline btn--pdf-download"
                        href={s.file}
                        download
                        data-track-download="true"
                        data-download-name={s.downloadLabel}
                        data-attribution={s.attribution}
                      >
                        <span class="btn-pdf-badge">PDF</span>
                        <span>{s.downloadLabel}</span>
                        <span class="btn-size-tag">({s.fileSize})</span>
                      </a>
                      <a class="btn btn--peach" href="/book">
                        Commission This Service
                      </a>
                    </div>
                    <div class="sample-attribution-line">
                      <span class="attribution-dot"></span>
                      <span>Attribution: {s.attribution} · Free for family memorial use</span>
                    </div>
                  </div>

                  <div class="sample-visual-side">
                    <div class="sample-visual-card">
                      <img src={s.image} alt={s.alt} loading="lazy" width="600" height="400" />
                      <div class="sample-visual-overlay">
                        <span class="sample-visual-badge">Visible Keepsake Preview</span>
                        <span class="sample-visual-caption">{s.imageCaption}</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="toolkit-card">
          <div class="toolkit-header">
            <div>
              <p class="eyebrow">Resource Toolkit</p>
              <h3>Downloadable Planning Resources</h3>
            </div>
            <span class="toolkit-badge">Printable PDFs</span>
          </div>
          <p class="toolkit-desc">
            Nicely formatted PDF templates with Cormorant Garamond typography and curated editorial imagery from the web, created to help families organize thoughts without slow generators.
          </p>

          <ul class="toolkit-list">
            <li>
              <div class="toolkit-item">
                <a
                  href="/downloads/eulogy-writing-guide.pdf"
                  download
                  class="toolkit-link"
                  data-track-download="true"
                  data-download-name="Eulogy Reflection & Writing Guide (PDF)"
                  data-attribution="Quills & Ink Hub Editorial Archive"
                >
                  <div class="toolkit-thumb-box">
                    <img
                      src="https://images.unsplash.com/photo-1457369804613-52c61a468e7d?auto=format&fit=crop&w=300&q=80"
                      alt="Eulogy Writing Guide Preview"
                      loading="lazy"
                    />
                    <span class="toolkit-thumb-badge">PDF</span>
                  </div>
                  <div class="toolkit-content">
                    <div class="toolkit-title-row">
                      <strong>Eulogy Reflection &amp; Writing Guide</strong>
                      <span class="file-tag">573 KB · PDF</span>
                    </div>
                    <span>Four pillars of remembrance, Akan family reflections, and delivery pacing</span>
                  </div>
                </a>
                <div class="toolkit-meta-row">
                  <span class="toolkit-source">Curated by Quills &amp; Ink Hub · Unsplash Editorial Imagery</span>
                  <a href="/samples/eulogy-writing-guide.txt" download class="txt-link" title="Plain text version">.TXT</a>
                </div>
              </div>
            </li>

            <li>
              <div class="toolkit-item">
                <a
                  href="/downloads/memorial-brochure-checklist.pdf"
                  download
                  class="toolkit-link"
                  data-track-download="true"
                  data-download-name="Memorial Keepsake Brochure Checklist (PDF)"
                  data-attribution="Quills & Ink Hub Print Division"
                >
                  <div class="toolkit-thumb-box">
                    <img
                      src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=300&q=80"
                      alt="Memorial Brochure Checklist Preview"
                      loading="lazy"
                    />
                    <span class="toolkit-thumb-badge">PDF</span>
                  </div>
                  <div class="toolkit-content">
                    <div class="toolkit-title-row">
                      <strong>Memorial Brochure Checklist &amp; Blueprint</strong>
                      <span class="file-tag">493 KB · PDF</span>
                    </div>
                    <span>Complete order of service, 300 DPI photo guidelines, and print specs</span>
                  </div>
                </a>
                <div class="toolkit-meta-row">
                  <span class="toolkit-source">Curated by Quills &amp; Ink Hub Print Division</span>
                  <a href="/samples/memorial-brochure-checklist.txt" download class="txt-link" title="Plain text version">.TXT</a>
                </div>
              </div>
            </li>

            <li>
              <div class="toolkit-item">
                <a
                  href="/downloads/tribute-reading-excerpt.pdf"
                  download
                  class="toolkit-link"
                  data-track-download="true"
                  data-download-name="Memorial Tribute Reading Excerpt (PDF)"
                  data-attribution="Quills & Ink Hub Spoken Archives"
                >
                  <div class="toolkit-thumb-box">
                    <img
                      src="https://images.unsplash.com/photo-1499209974431-9dddcece7f88?auto=format&fit=crop&w=300&q=80"
                      alt="Memorial Tribute Reading Preview"
                      loading="lazy"
                    />
                    <span class="toolkit-thumb-badge">PDF</span>
                  </div>
                  <div class="toolkit-content">
                    <div class="toolkit-title-row">
                      <strong>Memorial Tribute Reading Excerpt</strong>
                      <span class="file-tag">540 KB · PDF</span>
                    </div>
                    <span>Poetic tributes for family, children, and diaspora reflections</span>
                  </div>
                </a>
                <div class="toolkit-meta-row">
                  <span class="toolkit-source">Curated by Quills &amp; Ink Hub Spoken Archives</span>
                  <a href="/samples/tribute-excerpt.txt" download class="txt-link" title="Plain text version">.TXT</a>
                </div>
              </div>
            </li>
          </ul>

          <!-- Master Guide Highlight Card -->
          <div class="master-guide-banner">
            <div class="master-guide-thumb">
              <img
                src="https://images.unsplash.com/photo-1518199266791-5375a83190b7?auto=format&fit=crop&w=500&q=80"
                alt="Quills and Ink Family Memorial Guide Keepsake Cover"
                loading="lazy"
              />
              <span class="master-thumb-badge">Complete PDF</span>
            </div>
            <div class="master-guide-info">
              <span class="eyebrow" style="color: var(--color-peach-deep);">Comprehensive Master Edition</span>
              <h4>Family Memorial Guide &amp; Keepsake (PDF)</h4>
              <p>Everything in a single printable PDF guide for immediate download without waiting.</p>
            </div>
            <a
              href="/downloads/quills-and-ink-family-memorial-guide.pdf"
              download
              class="btn btn--peach master-guide-btn"
              data-track-download="true"
              data-download-name="Quills &amp; Ink Complete Memorial Guide (PDF)"
              data-attribution="Quills &amp; Ink Hub Central Archive"
            >
              <span>Download Master PDF</span>
              <span class="master-size-pill">573 KB</span>
            </a>
          </div>

          <!-- Formal Attribution Block -->
          <div class="toolkit-attribution-box">
            <div class="attribution-label">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              <span>Download Provenance &amp; Attribution</span>
            </div>
            <p>
              All guides and templates are prepared by <strong>Quills and Ink Hub</strong> (Accra, Ghana) to support bereaved Ghanaian and diaspora families. Free for personal family and church ceremonial use. Visual assets and abstract photography are sourced with attribution from Unsplash Editorial collections.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .literary {
    padding: 4.5rem 0 5.5rem;
    display: grid;
    gap: 3.5rem;
  }

  .literary__heading {
    margin-bottom: 2rem;
  }

  .literary__heading h2 {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-charcoal);
    margin-top: 0.25rem;
  }

  .services-list {
    display: grid;
    gap: 1.5rem;
  }

  .service-item {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    padding: 1.75rem 1.5rem;
    display: grid;
    gap: 0.65rem;
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .service-item:hover {
    transform: translateY(-2px);
    border-color: var(--color-peach);
  }

  .service-item__tag {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-peach-deep);
    font-weight: 500;
  }

  .service-item h3 {
    font-size: 1.5rem;
    color: var(--color-charcoal);
  }

  .service-item p {
    font-family: var(--font-serif);
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .literary__samples {
    display: grid;
    gap: 2.25rem;
  }

  /* YouTube Video View Box */
  .video-card {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    padding: 2.25rem 1.85rem;
    display: grid;
    gap: 1.25rem;
    box-shadow: 0 4px 20px rgba(26, 22, 18, 0.04);
  }

  .video-card__header {
    display: grid;
    gap: 0.5rem;
  }

  .video-card__header h3 {
    font-size: 1.75rem;
    color: var(--color-charcoal);
    line-height: 1.25;
  }

  .video-card__desc {
    font-family: var(--font-serif);
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .video-card__desc em {
    color: var(--color-charcoal);
    font-style: italic;
  }

  .video-card__player {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-charcoal);
    box-shadow: 0 12px 32px rgba(26, 22, 18, 0.16);
  }

  .video-card__player iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-card__caption {
    background: var(--color-ivory);
    border-left: 2px solid var(--color-peach);
    padding: 1.15rem 1.35rem;
    display: grid;
    gap: 0.35rem;
  }

  .video-card__quote {
    font-size: 1.65rem;
    color: var(--color-charcoal);
    line-height: 1.15;
    margin: 0;
  }

  .video-card__note {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .video-card {
      padding: 1.5rem 1.25rem;
    }

    .video-card__header h3 {
      font-size: 1.35rem;
    }

    .video-card__quote {
      font-size: 1.35rem;
    }
  }

  .samples-card {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    padding: 2.25rem 1.85rem;
    display: grid;
    gap: 1.25rem;
  }

  .samples-card h2 {
    font-size: 1.85rem;
    color: var(--color-charcoal);
  }

  .samples-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.75rem;
  }

  .sample-tab {
    background: none;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 0.5rem 0.85rem;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.25s var(--ease);
  }

  .sample-tab:hover {
    color: var(--color-ink);
    background: var(--color-soft);
  }

  .sample-tab.is-active {
    color: var(--color-charcoal);
    background: var(--color-soft);
    font-weight: 600;
  }

  .sample-panel {
    display: grid;
    gap: 1rem;
    animation: fade-in 0.4s var(--ease);
  }

  .sample-panel.is-hidden {
    display: none;
  }

  .sample-split-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 680px) {
    .sample-split-grid {
      grid-template-columns: 1.25fr 1fr;
      align-items: stretch;
      gap: 1.5rem;
    }
  }

  .sample-content-side {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .sample-visual-side {
    display: flex;
  }

  .sample-visual-card {
    position: relative;
    width: 100%;
    min-height: 220px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-soft);
    box-shadow: 0 6px 20px rgba(26, 22, 18, 0.06);
  }

  .sample-visual-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .sample-visual-card:hover img {
    transform: scale(1.04);
  }

  .sample-visual-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.25rem 1rem 0.85rem;
    background: linear-gradient(180deg, rgba(26, 22, 18, 0) 0%, rgba(26, 22, 18, 0.84) 100%);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sample-visual-badge {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f6d8be;
    font-weight: 600;
  }

  .sample-visual-caption {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    color: var(--color-white);
  }

  .sample-context {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-peach-deep);
  }

  blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-charcoal);
    border-left: 2px solid var(--color-peach);
    padding-left: 1.25rem;
  }

  blockquote p + p {
    margin-top: 1rem;
  }

  .sample-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .btn--pdf-download {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .btn-pdf-badge {
    background: #b85c18;
    color: white;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }

  .btn-size-tag {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .sample-attribution-line {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
    color: var(--color-muted);
    margin-top: 0.25rem;
  }

  .attribution-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-peach);
    display: inline-block;
  }

  /* Resource Toolkit Styling */
  .toolkit-card {
    background: var(--color-ivory);
    border: 1px solid var(--color-line);
    padding: 2.25rem 1.85rem;
    display: grid;
    gap: 1.25rem;
  }

  .toolkit-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .toolkit-card h3 {
    font-size: 1.45rem;
    color: var(--color-charcoal);
    margin-top: 0.2rem;
  }

  .toolkit-badge {
